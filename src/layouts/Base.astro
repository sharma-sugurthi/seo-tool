---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Search from '../components/Search.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description = SITE.description, type = 'website', image, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage = image ? new URL(image, Astro.site).toString() : new URL('/og-default.png', Astro.site).toString();
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  sameAs: Object.values(SITE.social).filter((s) => !s.includes('REPLACE_ME')),
};
const ld = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- Fonts (loaded in <head> to avoid render-blocking @import chain) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..900;1,14..32,300..900&family=Instrument+Serif:ital@0;1&display=swap" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {SITE.turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <script data-goatcounter="https://devrel.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <Search />
    <div class="read-progress" id="read-progress" hidden aria-hidden="true"></div>

    <!-- Scroll to top -->
    <button class="scroll-top" id="scroll-top" aria-label="Scroll to top" title="Back to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
    </button>

    <script>
      // Scroll-to-top button
      const scrollBtn = document.getElementById('scroll-top');
      const toggleScrollBtn = () => {
        scrollBtn?.classList.toggle('visible', window.scrollY > 400);
      };
      window.addEventListener('scroll', toggleScrollBtn, { passive: true });
      toggleScrollBtn();
      scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ---- Motion (see "Motion system" in global.css) ----
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll reveals: .fade-in and .reveal appear as they enter the viewport; .reveal-stagger children follow one another.
      const targets = document.querySelectorAll<HTMLElement>('.fade-in, .reveal, .reveal-stagger');
      targets.forEach((el) => { if (el.classList.contains('reveal-stagger')) [...el.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 11)))); });
      if ('IntersectionObserver' in window && !reduced) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting || e.boundingClientRect.top < 0) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('in'));
      }

      // Hero headline: one word at a time (plain-text headlines only)
      const h1 = document.querySelector<HTMLElement>('.hero h1');
      if (h1 && !reduced && h1.children.length === 0 && h1.textContent) {
        const words = h1.textContent.trim().split(/\s+/);
        h1.setAttribute('aria-label', h1.textContent.trim());
        h1.innerHTML = words.map((w, i) => `<span class="w" style="--i:${i}" aria-hidden="true">${w.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c] as string)}</span>`).join(' ');
      }

      // Count-up numbers: any element with data-count
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const runCount = (el: HTMLElement) => {
        const end = Number(el.dataset.count || el.textContent) || 0;
        if (reduced || end < 4) { el.textContent = String(end); return; }
        const t0 = performance.now(); const dur = 1100;
        const step = (now: number) => { const p = Math.min(1, (now - t0) / dur); const eased = 1 - Math.pow(1 - p, 3); el.textContent = String(Math.round(end * eased)); if (p < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) {
        const cio = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { runCount(e.target as HTMLElement); cio.unobserve(e.target); } }, { threshold: 0.5 });
        counters.forEach((el) => cio.observe(el));
      } else counters.forEach(runCount);

      // Spotlight: cards and tiles light up under the pointer
      if (window.matchMedia('(hover: hover)').matches) {
        document.addEventListener('pointermove', (e) => {
          const c = (e.target as Element).closest<HTMLElement>('.card, .tile');
          if (!c) return;
          const r = c.getBoundingClientRect();
          c.style.setProperty('--mx', `${e.clientX - r.left}px`);
          c.style.setProperty('--my', `${e.clientY - r.top}px`);
        }, { passive: true });
      }

      // Reading progress on long articles
      const bar = document.getElementById('read-progress');
      const article = document.querySelector<HTMLElement>('.article-layout article, .tool-layout article');
      if (bar && article) {
        bar.hidden = false;
        const onProgress = () => {
          const r = article.getBoundingClientRect();
          const total = r.height - window.innerHeight * 0.6;
          const done = Math.min(1, Math.max(0, -r.top / (total || 1)));
          bar.style.width = `${done * 100}%`;
        };
        window.addEventListener('scroll', onProgress, { passive: true });
        onProgress();
      }

      // Forms: show a loading state on the submit button (the form still posts normally)
      document.querySelectorAll<HTMLFormElement>('form[action]').forEach((f) => f.addEventListener('submit', () => {
        const b = f.querySelector<HTMLButtonElement>('button[type="submit"], .btn[type="submit"]');
        if (b && f.checkValidity()) { b.classList.add('is-loading'); b.setAttribute('aria-busy', 'true'); }
      }));

    </script>
  </body>
</html>
