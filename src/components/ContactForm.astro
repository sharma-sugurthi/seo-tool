---
import { SITE } from '../site.config';
interface Props {
  /** Which backend endpoint receives it. */
  kind?: 'contact' | 'service-order' | 'guest-pitch';
  options?: string[];
  optionsLabel?: string;
  placeholder?: string;
  submitLabel?: string;
}
const {
  kind = 'contact',
  options,
  optionsLabel = 'What are you interested in?',
  placeholder = 'What you need, links that help, and a deadline if there is one.',
  submitLabel = 'Send',
} = Astro.props;
---
<form class="stack" action={`${SITE.apiBase}/forms/${kind}`} method="POST">
  <label>Name <input name="name" required autocomplete="name" /></label>
  <label>Work email <input type="email" name="email" required autocomplete="email" /></label>
  <label>Company or website <input name="company" placeholder="https://" /></label>
  {options && (
    <label>{optionsLabel}
      <select name="interest">{options.map((o) => <option>{o}</option>)}</select>
    </label>
  )}
  <label>Details <textarea name="message" required placeholder={placeholder}></textarea></label>
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
  {SITE.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey}></div>}
  <button class="btn" type="submit">{submitLabel}</button>
  <p class="meta">A person replies within one business day.</p>
</form>
