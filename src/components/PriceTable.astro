---
import { SITE } from '../site.config';
import type { Price } from '../site.config';
interface Props { items: Price[]; ctaHref: string; ctaLabel?: string; ctaDataAttr?: string }
const { items, ctaHref, ctaLabel = 'Get started', ctaDataAttr } = Astro.props;
---
<div class="grid price-grid">
  {items.map((p) => (
    <div class={`card ${p.badge ? 'highlighted' : ''}`}>
      {p.badge && <span class="pill">{p.badge}</span>}
      <h3>{p.name}</h3>
      <div class="price">{p.price} {p.unit && <small>{p.unit}</small>}</div>
      <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
      <div class="row" style="margin-top:auto;">
        {p.itemKey ? (
          <>
            <a class="btn" href={`${SITE.apiBase}/checkout/direct?item=${p.itemKey}`}>Order</a>
            <button class="btn ghost" type="button" onclick="document.getElementById('dir-modal')?.showModal()">How it works</button>
          </>
        ) : (
          <a class={`btn ${p.badge ? '' : 'ghost'}`} href={p.buyHref ?? ctaHref} {...(ctaDataAttr ? { [ctaDataAttr]: p.name } : {})}>{p.buyHref ? (p.buyLabel ?? 'Buy now') : ctaLabel}</a>
        )}
      </div>
    </div>
  ))}
</div>
