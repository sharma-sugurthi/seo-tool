---
import type { Price } from '../site.config';
interface Props { items: Price[]; ctaHref: string; ctaLabel?: string }
const { items, ctaHref, ctaLabel = 'Get started' } = Astro.props;
---
<div class="grid price-grid">
  {items.map((p) => (
    <div class={`card ${p.badge ? 'highlighted' : ''}`}>
      {p.badge && <span class="pill">{p.badge}</span>}
      <h3>{p.name}</h3>
      <div class="price">{p.price} {p.unit && <small>{p.unit}</small>}</div>
      <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
      <div class="row" style="margin-top:auto;">
        <a class={`btn ${p.badge || p.buyHref ? '' : 'ghost'}`} href={p.buyHref ?? ctaHref}>{p.buyHref ? (p.buyLabel ?? 'Buy now') : ctaLabel}</a>
        {p.buyHref && <a class="btn ghost" href={ctaHref}>Ask first</a>}
      </div>
    </div>
  ))}
</div>
