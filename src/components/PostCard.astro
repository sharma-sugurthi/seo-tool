---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const d = post.data;
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readMin = Math.max(1, Math.ceil(wordCount / 200));
---
<article class="card" style="padding:0; overflow:hidden;">
  {d.thumbnail && (
    <a href={`/blog/${post.id}/`} style="display:block; width:100%; aspect-ratio:16/9; background:var(--muted); border-bottom:1px solid var(--border);">
      <img src={d.thumbnail} alt={d.title} style="width:100%; height:100%; object-fit:cover; display:block;" />
    </a>
  )}
  <div style="padding:1.5rem; display:flex; flex-direction:column; gap:.5rem; flex:1;">
    <div class="row" style="justify-content:space-between; margin-bottom:0;">
      <p class="meta" style="margin:0;">
        <time datetime={d.pubDate.toISOString()}>{d.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        {d.sponsored && <> &middot; <span class="pill warn">Sponsored</span></>}
      </p>
      <span class="read-time">{readMin} min read</span>
    </div>
    <h3 style="margin:0;"><a href={`/blog/${post.id}/`}>{d.title}</a></h3>
    <div style="flex:1;"></div>
    {d.tags.length > 0 && (
      <div class="row" style="gap:.3rem; margin-top:.5rem;">
        {d.tags.slice(0, 3).map((t) => <span class="pill" style="font-size:.68rem; padding:.12rem .5rem;">{t}</span>)}
      </div>
    )}
  </div>
</article>
