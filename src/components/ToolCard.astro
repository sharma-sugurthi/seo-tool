---
import type { CollectionEntry } from 'astro:content';
interface Props { tool: CollectionEntry<'tools'> }
const { tool } = Astro.props;
const d = tool.data;
const fullStars = d.rating ?? 0;
---
<article class="card" data-category={d.category} data-name={d.name.toLowerCase()}>
  <div class="row" style="justify-content:space-between; margin-bottom:.1rem;">
    <span class="pill">{d.category}</span>
    {d.featured && <span class="pill warn">Featured</span>}
  </div>
  <h3><a href={`/tools/${tool.id}/`}>{d.name}</a></h3>
  <p class="muted" style="margin:0; flex:1; font-size:.93rem;">{d.tagline}</p>
  {d.rating && (
    <div class="stars" aria-label={`Rating: ${d.rating} out of 5`}>
      {[1,2,3,4,5].map((i) => (
        <span class={`star ${i <= fullStars ? 'filled' : ''}`}>★</span>
      ))}
    </div>
  )}
  <p class="meta" style="margin:0;">{d.pricing} &middot; {d.bestFor}</p>
</article>
