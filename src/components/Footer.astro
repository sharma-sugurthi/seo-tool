---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap cols">
    <div>
      <strong style="font-size:1.05rem;">{SITE.name}</strong>
      <p style="margin: .5rem 0; line-height: 1.6;">{SITE.tagline}.</p>
      <p style="margin: .35rem 0;"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <div class="social-links">
        <a href={SITE.social.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn" title="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href={SITE.social.twitter} rel="me noopener" target="_blank" aria-label="X / Twitter" title="X / Twitter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href={SITE.social.reddit} rel="me noopener" target="_blank" aria-label="Reddit" title="Reddit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
        </a>
        <a href="/rss.xml" aria-label="RSS Feed" title="RSS Feed">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
        </a>
      </div>
    </div>
    <div>
      <strong>Explore</strong><br />
      <a href="/tools/">Tool directory</a><br />
      <a href="/blog/">Blog</a><br />
      <a href="/about/">About</a>
    </div>
    <div>
      <strong>Work with us</strong><br />
      <a href="/services/">Growth services</a><br />
      <a href="/advertise/">Advertise and sponsored posts</a><br />
      <a href="/write-for-us/">Write for us</a><br />
      <a href="/submit-tool/">Submit a tool</a>
    </div>
    <div>
      <strong>Company</strong><br />
      <a href="/about/">About and editorial policy</a><br />
      <a href="/contact/">Contact</a>
    </div>
  </div>
  <div class="wrap bottom-bar">
    <p>&copy; {year} {SITE.name}. Sponsored content is always labelled and paid links carry rel="sponsored".</p>
  </div>
</footer>
