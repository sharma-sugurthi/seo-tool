---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="hero" style="padding:6rem 0; max-width:36rem;">
    <h1 style="font-size:1.5rem; font-family:var(--font); font-weight:700; font-style:normal;">Page not found</h1>
    <p class="lead" style="font-size:1rem;">That page has moved or never existed. Try the <a href="/tools/">tool directory</a>, the <a href="/blog/">blog</a>, or head <a href="/">home</a>.</p>
  </section>
</Base>
