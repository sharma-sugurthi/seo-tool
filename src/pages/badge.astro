---
import Base from '../layouts/Base.astro';
import { SITE, REVIEW_SLA } from '../site.config';

import { getCollection } from 'astro:content';
const tools = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name));
// Default embed links to the directory; picking a tool below rewrites it to that tool's review page (the "links back to your tool page" promise).
const badgeSvg = `<a href="${SITE.url}/" target="_blank" rel="noopener"><img src="${SITE.url}/badge-lantle.svg" alt="Reviewed on ${SITE.name}" width="160" height="36" /></a>`;
const badgeMd = `[![Reviewed on ${SITE.name}](${SITE.url}/badge-lantle.svg)](${SITE.url}/)`;
---
<Base title="Verified by Lantle badge" description="Embed the Lantle badge on your site to show your tool has been independently reviewed. Free for every listed tool.">
  <section class="hero">
    <h1>Show you are reviewed on {SITE.name}</h1>
    <p class="lead">Every tool listed in our directory can embed this badge on their website. It tells visitors a person looked at your product and wrote it up, rather than scraping it from a list.</p>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">The badge</h2>
    <div class="badge-preview">
      <img src="/badge-lantle.svg" alt={`Reviewed on ${SITE.name}`} width="160" height="36" />
    </div>
    <p class="muted" style="margin-top:1rem;">Free for every listed tool. No featured listing required.</p>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">Embed code</h2>
    <label style="max-width:28rem; display:grid; gap:.3rem; margin-bottom:1rem;">Your tool <small class="muted">so the badge links to your review page</small>
      <select id="badge-tool"><option value="">Pick your tool</option>{tools.map((t) => <option value={t.id}>{t.data.name}</option>)}</select>
    </label>

    <h3>HTML</h3>
    <p class="muted" style="margin-bottom:.5rem;">Copy and paste this into your website footer, about page or integrations page.</p>
    <div class="code-block">
      <pre><code id="code-html">{badgeSvg}</code></pre>
      <button class="btn ghost copy-btn" data-copy={badgeSvg} data-for="code-html" style="margin-top:.5rem; font-size:.82rem; padding:.4rem .9rem;">Copy HTML</button>
    </div>

    <h3 style="margin-top:1.5rem;">Markdown</h3>
    <p class="muted" style="margin-bottom:.5rem;">For GitHub READMEs and documentation sites.</p>
    <div class="code-block">
      <pre><code id="code-md">{badgeMd}</code></pre>
      <button class="btn ghost copy-btn" data-copy={badgeMd} data-for="code-md" style="margin-top:.5rem; font-size:.82rem; padding:.4rem .9rem;">Copy Markdown</button>
    </div>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">Why add the badge?</h2>
    <ul style="padding-left:1.25rem; display:grid; gap:.5rem;">
      <li><strong>Trust signal.</strong> Visitors see that an independent reviewer has looked at your product.</li>
      <li><strong>Links to your review.</strong> Pick your tool above and the badge links to your review page on {SITE.name}. It is optional: your listing's link type never depends on embedding it.</li>
      <li><strong>Zero effort.</strong> Copy the code, paste it, done. No approval process or ongoing cost.</li>
    </ul>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">Not listed yet?</h2>
    <p class="muted">Submit your tool for free and get the badge within {REVIEW_SLA}.</p>
    <div style="margin-top:.75rem;"><a class="btn" href="/submit-tool/">Submit your tool</a></div>
  </section>

  <script>
    // Rewrite the embed code to the chosen tool's review page
    const sel = document.getElementById('badge-tool') as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      const base = location.origin;
      const target = sel.value ? `${base}/tools/${sel.value}/` : `${base}/`;
      const html = `<a href="${target}" target="_blank" rel="noopener"><img src="${base}/badge-lantle.svg" alt="Reviewed on Lantle" width="160" height="36" /></a>`;
      const md = `[![Reviewed on Lantle](${base}/badge-lantle.svg)](${target})`;
      const h = document.getElementById('code-html'); const m = document.getElementById('code-md');
      if (h) h.textContent = html; if (m) m.textContent = md;
      document.querySelectorAll<HTMLElement>('.copy-btn').forEach((b) => { b.dataset.copy = b.dataset.for === 'code-html' ? html : md; });
    });
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = (btn as HTMLElement).dataset.copy || '';
        navigator.clipboard.writeText(text).then(() => {
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = orig; }, 2000);
        });
      });
    });
  </script>
</Base>
