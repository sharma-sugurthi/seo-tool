---
import Base from '../layouts/Base.astro';
import { SITE, ADVERTISE_PRICES, SPONSORED_WRITING_FEE, SPONSORED_ARTICLE_LENGTH } from '../site.config';
import { VERTICALS, FEATURES, PLATFORMS, DEPLOYMENTS, COMPANY_SIZES } from '../data/taxonomy';
import { getCollection } from 'astro:content';

const featured = ADVERTISE_PRICES.find((p) => p.name === 'Featured tool listing')!;
const sponsored = ADVERTISE_PRICES.find((p) => p.name === 'Sponsored article')!;
const taxonomy = Object.fromEntries(VERTICALS.map((v) => [v.slug, v.categories]));
const tools = await getCollection('tools');
const comparePages = (() => { let n = 0; const byCat = new Map<string, number>(); tools.forEach((t) => byCat.set(t.data.category, (byCat.get(t.data.category) ?? 0) + 1)); byCat.forEach((c) => (n += (c * (c - 1)) / 2)); return n; })();

const categoryOptions = VERTICALS.map((v) => ({ slug: v.slug, name: v.name }));
const subcategoryOptions = [...VERTICALS[0].categories, 'Other (tell us in the notes)'];
---
<Base title="List your tool" description="List any software or AI tool. An editor reviews it within five business days; it gets a review page, a place in its category, and appears on the compare and alternatives pages automatically.">
  <section class="hero">
    <p class="meta eyebrow">For the people who build software</p>
    <h1>List your tool</h1>
    <p class="lead">Every listing is reviewed by an editor within five business days. Approved tools get a dedicated review page, appear in their category, and are included in the compare and alternatives pages automatically. Ratings are never for sale.</p>
    <div class="stats-bar">
      <div class="stat"><span class="stat-number" data-count={tools.length}>{tools.length}</span><span class="stat-label">Tools listed</span></div>
      <div class="stat"><span class="stat-number" data-count={comparePages}>{comparePages}</span><span class="stat-label">Compare pages</span></div>
      <div class="stat"><span class="stat-number">5</span><span class="stat-label">Business days to review</span></div>
    </div>
  </section>

  <section class="section grid reveal-stagger plans" id="plans">
    <div class="card plan-card" data-plan="basic">
      <h3>Basic listing</h3>
      <div class="price">Free</div>
      <ul>
        <li>Review page with tagline, screenshot and pricing</li>
        <li>Included in category listings</li>
        <li>Upgrade to a full profile at any time to unlock the sidebar and comparison pages</li>
        <li>Nofollow link · reviewed within 5 business days</li>
      </ul>
      <button class="btn ghost plan-pick" type="button" data-pick="basic">Start a free listing</button>
    </div>
    <div class="card plan-card" data-plan="featured">
      <span class="pill">Most chosen</span>
      <h3>Featured listing</h3>
      <div class="price">{featured.price} <small>{featured.unit}</small></div>
      <ul>
        <li>Full profile with sidebar, pros/cons and comparison pages</li>
        <li>Dofollow link · pinned to the top of your category for 12 months</li>
        <li>Eligible for "best tools" roundup articles</li>
        <li>We do the heavy lifting - just pay and we build your page</li>
      </ul>
      <button class="btn plan-pick" type="button" data-pick="featured">Get featured</button>
    </div>
    <div class="card plan-card" data-plan="sponsored">
      <h3>Sponsored article</h3>
      <div class="price">{sponsored.price} <small>{sponsored.unit}</small></div>
      <ul>{sponsored.points.map((pt) => <li>{pt}</li>)}</ul>
      <button class="btn ghost plan-pick" type="button" data-pick="sponsored">Book an article</button>
    </div>
  </section>

  <section class="section reveal" id="listing-form">
    <div class="wizard-head">
      <div>
        <h2 id="form-title" style="margin:0;">Free listing</h2>
        <p class="muted" id="form-sub" style="margin:.25rem 0 0;">Two steps. Your draft is saved in this browser until you submit.</p>
      </div>
      <ol class="steps-nav" id="steps-nav" aria-label="Steps">
        <li class="on" data-step="1"><span>1</span> Your tool</li>
        <li data-step="2"><span>2</span> Full profile <small style="font-weight:400;opacity:.7">(optional)</small></li>
      </ol>
    </div>
    <div class="progress" aria-hidden="true"><div class="progress-bar" id="progress-bar"></div></div>

    <form class="stack wizard" id="submit-form" action={`${SITE.apiBase}/submissions`} method="POST" enctype="multipart/form-data" novalidate
      data-featured-price={`${featured.price} ${featured.unit}`}
      data-sponsored-price={`${sponsored.price} ${sponsored.unit}`}>
      <input type="hidden" name="listing_type" id="listing-type" value="basic" />

      {/* ════ STEP 1: Core info - required for ALL plans ════ */}
      <fieldset class="step" data-step="1">
        <div class="two">
          <label>Company or tool name <input name="tool_name" required maxlength="80" id="tool-name-input" /></label>
          <label>Website <input type="url" name="website" required placeholder="https://" id="website-input" /></label>
        </div>
        <div class="two">
          <label>
            Work email
            <input type="email" name="email" required autocomplete="email" id="email-input" />
            <span class="field-hint" id="email-hint" style="font-size:.82rem;color:var(--muted);display:none;margin-top:.25rem;">Checking email…</span>
          </label>
          <label>Your name <input name="submitter_name" autocomplete="name" /></label>
        </div>

        {/* Category + Pricing - basic only, paid plans skip */}
        <div class="two basic-only">
          <label>Category <select name="vertical" id="vertical-select">{categoryOptions.map((v) => <option value={v.slug}>{v.name}</option>)}</select></label>
          <label>Subcategory <select name="category" id="category-select">{subcategoryOptions.map((c) => <option>{c}</option>)}</select></label>
        </div>
        <div class="two basic-only">
          <label>Pricing model <select name="pricing"><option>Free</option><option>Freemium</option><option>Paid</option><option>Enterprise</option></select></label>
          <label>Tagline <small>shown on the card, max 140 characters</small><input name="tagline" maxlength="140" data-req-basic id="tagline-input" /></label>
        </div>

        {/* Screenshot - required for basic, shown for basic only (paid fills later) */}
        <div class="basic-only">
          <label>
            Screenshot of main page <small>required - PNG, JPG or WebP up to 5 MB, at least 600 px wide</small>
            <input type="file" name="thumbnail" accept="image/png,image/jpeg,image/webp" data-req-basic id="screenshot-input" />
          </label>
          <p class="meta" style="margin:.25rem 0 0; font-size:.82rem;">Or paste an image URL instead:</p>
          <input type="url" name="thumbnail_url" placeholder="https://" style="margin-top:.35rem;" />
        </div>

        {/* What does it do - required for basic, shown for basic only */}
        <div class="basic-only">
          <label>
            What does it do?
            <small>the core workflow and the problem it solves, 2 to 4 sentences</small>
            <textarea name="what_it_does" data-req-basic rows="4" placeholder="Describe the core workflow and the problem it solves."></textarea>
          </label>
        </div>

        {/* Paid plan notice */}
        <p class="meta paid-only" hidden>We do the heavy lifting. After checkout you get a private link by email - your full profile page will be built for you within 3 business days.</p>

        {/* Sponsored article extras */}
        <div class="sponsored-only" hidden>
          <div class="two">
            <label>Author name <small>who the article is attributed to</small><input name="author_name" /></label>
            <label class="chk-row"><input type="checkbox" name="written_by_us" /> Write the article for me (+{SPONSORED_WRITING_FEE})</label>
          </div>
        </div>
      </fieldset>

      {/* ════ STEP 2: Full profile - optional for free, not shown for paid ════ */}
      <fieldset class="step" data-step="2" hidden>
        <p class="muted" style="margin:0 0 .5rem;">This step is optional. Fill it in to unlock the sidebar, the pros/cons bullets, and inclusion in the "vs" and "alternatives" comparison pages. It takes about 5 minutes.</p>

        <label>Where does it beat the alternatives? <small>be specific, name the workflow or the customer type</small><textarea name="where_it_shines" rows="4" placeholder="e.g. Approval chains by threshold beat Stampli because they need zero IT setup."></textarea></label>
        <label>Where does it fall short? <small>an honest limitation reads as credible - editors remove spin</small><textarea name="where_it_falls_short" rows="3" placeholder="e.g. Per-user pricing climbs fast when five people approve invoices."></textarea></label>
        <label>Conclusion <small>optional, one paragraph: who should pick it and why</small><textarea name="conclusion" rows="3"></textarea></label>
        <label>Best for <small>one phrase, e.g. "small businesses and accounting firms that pay many vendor bills"</small><input name="best_for" maxlength="120" /></label>

        <hr style="margin:.5rem 0;border:0;border-top:1px solid var(--border);" />
        <p class="lbl" style="margin:.25rem 0 .5rem;">Sidebar data <small style="font-weight:400;color:var(--muted);">(optional - fills the sidebar on your tool page)</small></p>

        <div class="two">
          <label>Starting price <small>cheapest paid plan; leave empty if quote-only</small><input name="starting_price" maxlength="60" placeholder="$20 per user per month" /></label>
          <label>Free trial <small>days (0 for none)</small><input type="number" name="trial_days" min="0" max="365" /></label>
        </div>
        <div class="two">
          <label>Permanent free plan <select name="free_tier"><option value="">Not sure</option><option value="yes">Yes</option><option value="no">No</option></select></label>
          <label>Deployment <select name="deployment"><option value="">Not sure</option>{DEPLOYMENTS.map((x) => <option value={x}>{x}</option>)}</select></label>
        </div>

        <div><span class="lbl">Platforms</span><div class="chks">{PLATFORMS.map((p) => <label class="chk"><input type="checkbox" name="platforms" value={p} /> {p}</label>)}</div></div>

        <div><span class="lbl">Features it has</span><div class="chks" id="feature-box">{FEATURES[VERTICALS[0].slug].map((f) => <label class="chk"><input type="checkbox" name="key_features" value={f} /> {f}</label>)}</div></div>

        <label>Native integrations <small>comma separated, up to 10</small><input name="integrations" placeholder="Slack, HubSpot, QuickBooks" /></label>
        <div class="two">
          <label>Pros <small>one per line, 3 to 5</small><textarea name="pros" rows="4" placeholder={"Receipts match themselves from a phone photo\nPolicy checks run at the point of purchase"}></textarea></label>
          <label>Cons <small>one per line, 2 to 4</small><textarea name="cons" rows="4" placeholder={"Cards are US only\nNo JetBrains plugin"}></textarea></label>
        </div>
        <label>One-line verdict <small>"Pick &lt;name&gt; if …", max 160 characters</small><input name="verdict_line" maxlength="160" /></label>
        <label>Notes for the editor <small>not published</small><textarea name="notes" rows="2" placeholder="A category we are missing, a launch date, anything the editor should know."></textarea></label>
      </fieldset>

      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      {SITE.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey}></div>}
      <div class="wizard-foot">
        <button class="btn ghost" type="button" id="btn-back" hidden>Back</button>
        <span class="meta" id="step-hint">Step 1 of 2</span>
        <button class="btn ghost" type="button" id="btn-skip" hidden>Submit basic listing</button>
        <button class="btn" type="button" id="btn-next">Continue</button>
        <button class="btn" type="submit" id="btn-submit" hidden>Submit for review</button>
      </div>
      <p class="meta">Questions before you list? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </form>
  </section>

  <section class="section reveal">
    <div class="grid">
      <div class="card"><h3>What the editor checks</h3><p class="muted desc">That the product exists and does what the listing says, that the category is right, and that the description reads like a review, not an advert. Marketing words are edited out.</p></div>
      <div class="card"><h3>What paid placement buys</h3><p class="muted desc">Position and a dofollow link. Not the rating, not the verdict on a compare page, not a place in an alternatives ranking. Those come from editorial data only.</p></div>
      <div class="card"><h3>If a listing is declined</h3><p class="muted desc">You get the reason by email and a link to fix it. A paid listing that cannot be fixed is refunded in full.</p></div>
    </div>
  </section>

  <script type="application/json" id="taxonomy-data" set:html={JSON.stringify(taxonomy)} />
  <script type="application/json" id="features-data" set:html={JSON.stringify(FEATURES)} />
  <script>
    const form = document.getElementById('submit-form') as HTMLFormElement;
    const typeInput = document.getElementById('listing-type') as HTMLInputElement;
    const allSteps = [...form.querySelectorAll<HTMLFieldSetElement>('.step')];
    const nav = document.getElementById('steps-nav')!;
    const bar = document.getElementById('progress-bar')!;
    const back = document.getElementById('btn-back')!;
    const next = document.getElementById('btn-next')!;
    const skip = document.getElementById('btn-skip')!;
    const submitBtn = document.getElementById('btn-submit')!;
    const hint = document.getElementById('step-hint')!;
    const title = document.getElementById('form-title')!;
    const sub = document.getElementById('form-sub')!;
    const emailInput = document.getElementById('email-input') as HTMLInputElement;
    const emailHint = document.getElementById('email-hint') as HTMLElement;
    const featuredPrice = form.dataset.featuredPrice || '';
    const sponsoredPrice = form.dataset.sponsoredPrice || '';
    let plan: 'basic' | 'featured' | 'sponsored' = 'featured';
    let step = 1;
    const totalSteps = () => (plan === 'basic' ? 2 : 1);

    // ── Email MX check ──────────────────────────────────
    let mxTimer: ReturnType<typeof setTimeout> | null = null;
    let mxValid: boolean | null = null;
    emailInput.addEventListener('blur', () => {
      const v = emailInput.value.trim();
      if (!v || !v.includes('@')) return;
      if (mxTimer) clearTimeout(mxTimer);
      mxTimer = setTimeout(async () => {
        emailHint.textContent = 'Checking email…';
        emailHint.style.color = 'var(--muted)';
        emailHint.style.display = 'block';
        try {
          const res = await fetch(`/api/check-email?email=${encodeURIComponent(v)}`);
          const data = await res.json() as { valid: boolean; reason?: string };
          mxValid = data.valid;
          if (data.valid) {
            emailHint.textContent = '✓ Email looks good';
            emailHint.style.color = 'var(--accent)';
          } else {
            emailHint.textContent = data.reason || 'That email address does not appear to exist.';
            emailHint.style.color = 'var(--warn, #b45309)';
          }
        } catch {
          emailHint.style.display = 'none';
          mxValid = null;
        }
      }, 600);
    });

    // ── Plan switching ────────────────────────────────────
    function applyPlan() {
      typeInput.value = plan;
      form.querySelectorAll<HTMLElement>('.sponsored-only').forEach((e) => (e.hidden = plan !== 'sponsored'));
      form.querySelectorAll<HTMLElement>('.paid-only').forEach((e) => (e.hidden = plan === 'basic'));
      form.querySelectorAll<HTMLElement>('.basic-only').forEach((e) => (e.hidden = plan !== 'basic'));
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-req-basic]').forEach((e) => (e.required = plan === 'basic'));
      nav.hidden = plan !== 'basic';
      document.querySelectorAll<HTMLElement>('.plan-card').forEach((c) => {
        const isChosen = c.dataset.plan === plan;
        c.classList.toggle('chosen', isChosen);
        c.classList.toggle('highlighted', isChosen);
      });
      if (plan === 'basic') {
        title.textContent = 'Free listing';
        sub.textContent = 'Two steps. Step 2 is optional - submit early for a basic profile or complete it for the full profile with sidebar and comparison pages.';
      } else if (plan === 'featured') {
        title.textContent = `Featured listing · ${featuredPrice}`;
        sub.textContent = 'One step, then checkout. We build the full profile page for you within 3 business days.';
      } else {
        title.textContent = `Sponsored article · ${sponsoredPrice}`;
        sub.textContent = 'One step, then checkout. The article draft and topic are added from your private link after payment.';
      }
      submitBtn.textContent = plan === 'basic' ? 'Submit for review' : 'Continue to payment';
      step = 1;
      show();
    }

    function show() {
      allSteps.forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
      nav.querySelectorAll('li').forEach((li) => {
        const n = Number(li.dataset.step);
        li.classList.toggle('on', n === step);
        li.classList.toggle('done', n < step);
      });
      bar.style.width = `${(step / totalSteps()) * 100}%`;
      back.hidden = step === 1;
      next.hidden = step === totalSteps() || plan !== 'basic';
      // Skip = "Submit basic listing" shown only on step 2 for basic plan
      skip.hidden = !(plan === 'basic' && step === 2);
      submitBtn.hidden = !(step === totalSteps());
      hint.textContent = plan === 'basic' ? `Step ${step} of ${totalSteps()}` : 'One step, then checkout';
    }

    function valid(): boolean {
      const fields = [...allSteps[step - 1].querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select')]
        .filter((f) => !f.closest('[hidden]'));
      for (const f of fields) {
        if (!f.checkValidity()) { f.reportValidity(); return false; }
      }
      // Warn on bad email MX but don't hard block (backend will catch it)
      if (step === 1 && mxValid === false) {
        if (!confirm('The email address does not appear to exist. Continue anyway?')) return false;
      }
      return true;
    }

    next.addEventListener('click', () => {
      if (!valid()) return;
      step++;
      show();
      document.getElementById('listing-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    back.addEventListener('click', () => { step--; show(); });

    // "Submit basic listing" - skip Step 2 by removing required attrs from Step 2 fields then submit
    skip.addEventListener('click', () => {
      allSteps[1]?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]').forEach((f) => f.removeAttribute('required'));
      form.requestSubmit();
    });

    form.addEventListener('submit', (e) => {
      if (!valid()) { e.preventDefault(); return; }
      try { localStorage.removeItem('lantle-submit-draft'); } catch {}
    });

    document.querySelectorAll<HTMLButtonElement>('.plan-pick').forEach((b) =>
      b.addEventListener('click', () => {
        plan = b.dataset.pick as typeof plan;
        applyPlan();
        document.getElementById('listing-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );

    // Pre-select plan from URL ?plan=featured or ?plan=basic
    const wanted = new URLSearchParams(location.search).get('plan');
    if (wanted === 'basic' || wanted === 'featured' || wanted === 'sponsored') plan = wanted;

    // ── Subcategory + feature options follow the category ──
    const taxonomy: Record<string, string[]> = JSON.parse(document.getElementById('taxonomy-data')?.textContent || '{}');
    const features: Record<string, string[]> = JSON.parse(document.getElementById('features-data')?.textContent || '{}');
    const verticalSel = document.getElementById('vertical-select') as HTMLSelectElement;
    const categorySel = document.getElementById('category-select') as HTMLSelectElement;
    const featureBox = document.getElementById('feature-box')!;
    verticalSel?.addEventListener('change', () => {
      categorySel.innerHTML = '';
      [...(taxonomy[verticalSel.value] || []), 'Other (tell us in the notes)'].forEach((c) => {
        const o = document.createElement('option'); o.textContent = c; categorySel.appendChild(o);
      });
      featureBox.innerHTML = '';
      (features[verticalSel.value] || []).forEach((f) => {
        const l = document.createElement('label'); l.className = 'chk';
        const i = document.createElement('input'); i.type = 'checkbox'; i.name = 'key_features'; i.value = f;
        l.append(i, ' ' + f); featureBox.appendChild(l);
      });
    });

    // ── Browser draft save/restore ──────────────────────────
    const KEY = 'lantle-submit-draft';
    const textFields = () => [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      'input:not([type=file]):not([type=checkbox]):not([type=hidden]), textarea, select'
    )];
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
      textFields().forEach((f) => { if (saved[f.name] && f.name !== '_gotcha') f.value = saved[f.name]; });
      if (saved.vertical) verticalSel?.dispatchEvent(new Event('change'));
      if (saved.category) categorySel.value = saved.category;
    } catch {}
    form.addEventListener('input', () => {
      try {
        const o: Record<string, string> = {};
        textFields().forEach((f) => { if (f.value && f.name !== '_gotcha') o[f.name] = f.value; });
        localStorage.setItem(KEY, JSON.stringify(o));
      } catch {}
    });

    applyPlan();
  </script>
</Base>
