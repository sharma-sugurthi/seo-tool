---
import Base from '../layouts/Base.astro';
import { SITE, ADVERTISE_PRICES } from '../site.config';
const featured = ADVERTISE_PRICES.find((p) => p.name === 'Featured tool listing')!;
const sponsored = ADVERTISE_PRICES.find((p) => p.name === 'Sponsored article')!;
const featuredPrice = `${featured.price} ${featured.unit}`;
const sponsoredPrice = `${sponsored.price} ${sponsored.unit}`;
---
<Base title="Submit a tool or advertise" description="Add your AI tool to our finance and accounting directory. Free basic listing, featured placements, and sponsored articles available.">
  <section class="hero">
    <h1>Submit a tool or advertise</h1>
    <p class="lead">Get your product in front of accountants, controllers, bookkeepers and founders comparing AI tools before they buy.</p>
  </section>

  <section class="section grid fade-in">
    <div class="card">
      <h3>Basic listing</h3>
      <div class="price">Free</div>
      <ul><li>Name, tagline, category, pricing</li><li>Nofollow link to your site</li><li>Reviewed within 5 business days</li></ul>
      <a class="btn ghost" href="#listing-form" style="align-self:flex-start; margin-top:auto;">Submit free</a>
    </div>
    <div class="card highlighted">
      <span class="pill">Recommended</span>
      <h3>Featured listing</h3>
      <div class="price">{featured.price} <small>{featured.unit}</small></div>
      <ul><li>Everything in basic</li><li>Dofollow link and custom thumbnail</li><li>Pinned to the top of your category</li><li>Considered for "best tools" roundups</li></ul>
      <a class="btn" href="#listing-form" id="order-featured" style="align-self:flex-start; margin-top:auto;">Order featured</a>
    </div>
    <div class="card">
      <h3>Sponsored article</h3>
      <div class="price">{sponsored.price} <small>{sponsored.unit}</small></div>
      <ul><li>Up to 2 dofollow links</li><li>800 to 1,500 words, written by you or us</li><li>Permanent, indexed, shared on LinkedIn</li><li>Live within 3 business days</li></ul>
      <a class="btn ghost" href="#listing-form" id="order-sponsored" style="align-self:flex-start; margin-top:auto;">Order article</a>
    </div>
  </section>

  <section class="section fade-in" id="listing-form">
    <h2 style="margin-top:0">Details</h2>
    <p class="muted" style="margin-bottom:1rem;">Fill in the form below. For paid options, we send a PayPal invoice within 4 hours.</p>
    <form class="stack" action={SITE.formEndpoint} method="POST">
      <input type="hidden" name="_subject" value="Tool submission" />
      <label>Tool name <input name="tool_name" required /></label>
      <label>Website URL <input type="url" name="website" required placeholder="https://" /></label>
      <label>One line tagline (max 140 characters) <input name="tagline" maxlength="140" required /></label>
      <label>Category
        <select name="category">
          <option>Bookkeeping</option><option>Accounts payable</option><option>Expense management</option><option>FP&amp;A and forecasting</option><option>Tax</option><option>Invoicing and AR</option><option>Spend cards</option><option>Business operations</option>
        </select>
      </label>
      <label>Pricing model <select name="pricing"><option>Free</option><option>Freemium</option><option>Paid</option><option>Enterprise</option></select></label>
      <label>Who is it best for? <input name="best_for" placeholder="e.g. bookkeeping firms with 20 to 200 clients" /></label>
      <label>Screenshot or product image URL (optional) <input type="url" name="thumbnail_url" placeholder="https://yoursite.com/screenshot.png" /></label>
      <p class="muted" style="margin:-.5rem 0 0; font-size:.84rem;">Link to a screenshot of your dashboard or your logo. PNG or WebP, at least 600px wide. If you skip this, we will use a screenshot from your website.</p>
      <label>What would you like? <select name="listing_type" id="listing-type"><option value="basic">Basic listing (free)</option><option value="featured">Featured listing ({featuredPrice})</option><option value="sponsored">Sponsored article ({sponsoredPrice})</option></select></label>
      <label>Your email <input type="email" name="email" required /></label>
      <label>Anything else <textarea name="message" placeholder="Short description, what makes it different, link to a demo or press kit."></textarea></label>
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <button class="btn" type="submit">Submit</button>
      <p class="meta">We reply within one business day. Or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </form>
  </section>

  <script>
    document.getElementById('order-featured')?.addEventListener('click', () => {
      const sel = document.getElementById('listing-type') as HTMLSelectElement | null;
      if (sel) sel.value = 'featured';
    });
    document.getElementById('order-sponsored')?.addEventListener('click', () => {
      const sel = document.getElementById('listing-type') as HTMLSelectElement | null;
      if (sel) sel.value = 'sponsored';
    });
  </script>
</Base>
