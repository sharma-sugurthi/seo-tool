---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from './tag/[tag].astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Blog: how teams actually use AI tools, by practitioners" description="Reviews, comparisons and how-tos on picking, rolling out and getting value from AI tools at work, written by people who use them.">
  <section class="hero">
    <h1>Blog</h1>
    <p class="lead">Practical writing on choosing, rolling out and getting value from AI tools. Finance heavy so far, because that is where the directory started.</p>
  </section>
  <div class="grid fade-in">{posts.map((p) => <PostCard post={p} />)}</div>
</Base>
