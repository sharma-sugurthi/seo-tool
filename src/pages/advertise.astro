---
import Base from '../layouts/Base.astro';
import PriceTable from '../components/PriceTable.astro';
import { ADVERTISE_PRICES, SITE, SPONSORED_WRITING_FEE } from '../site.config';

const faqs = [
  {
    q: 'Are the links dofollow?',
    a: 'Yes. Sponsored articles include up to 2 dofollow links with rel="sponsored". Link insertions are also dofollow. This is transparent to search engines and compliant with Google\'s link spam policies.',
  },
  {
    q: 'How long does the content stay live?',
    a: 'All placements are permanent. Sponsored articles and link insertions remain on the site indefinitely and stay indexed.',
  },
  {
    q: 'Can I write the article myself?',
    a: `Yes, you can provide a draft and we will edit it for our audience. Or we can write it for you for an additional fee of ${SPONSORED_WRITING_FEE}. Either way, articles must teach the reader something, not just promote.`,
  },
  {
    q: 'What topics do you accept?',
    a: 'Finance, accounting, fintech, B2B SaaS, business operations and related technology. We decline casinos, crypto trading, adult content, payday loans and essay mills, with no exceptions.',
  },
  {
    q: 'How do I pay?',
    a: `We send a PayPal invoice within 4 hours of your order. Payment is upfront by ${SITE.paymentMethods}. If we decline the content after reviewing it, you receive a full refund.`,
  },
];
---
<Base title="Advertise: sponsored posts, link insertions and featured listings" description="Reach accountants, finance leaders and founders evaluating AI tools. Sponsored articles, contextual link insertions, featured directory listings and homepage spotlights.">
  <section class="hero">
    <h1>Advertise with {SITE.name}</h1>
    <p class="lead">Our readers are accountants, controllers, bookkeepers and founders comparing AI tools before they buy. Put your product in front of them with content that stays live and indexed.</p>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">Options and pricing</h2>
    <PriceTable items={ADVERTISE_PRICES} ctaHref="#order" ctaLabel="Order" />
    <p class="muted" style="margin-top:1rem; font-size:.9rem;">Need a link inserted into an existing article, or a homepage spotlight? <a href="#order">Email us</a> -- we offer those for established partners.</p>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">Frequently asked questions</h2>
    <div class="faq-list">
      {faqs.map(({ q, a }) => (
        <details class="faq">
          <summary>{q}</summary>
          <div class="faq-body"><p>{a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <section class="section fade-in" id="order">
    <h2 style="margin-top:0">Place your order</h2>
    <p class="muted" style="margin-bottom:1rem;">Tell us what you need and we send a PayPal invoice within 4 hours. Your content goes live within 3 business days of payment.</p>
    <form class="stack" action={SITE.formEndpoint} method="POST" style="max-width:28rem;">
      <input type="hidden" name="_subject" value="Advertising order" />
      <label>Work email <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" /></label>
      <label>What would you like?
        <select name="interest">
          <option>Sponsored article</option>
          <option>Featured tool listing</option>
          <option>Something else</option>
        </select>
      </label>
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <button class="btn" type="submit">Send</button>
    </form>
    <p class="meta" style="margin-top:.75rem;">Prefer email? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </section>
</Base>
