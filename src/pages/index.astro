---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import { VERTICALS } from '../data/taxonomy';

const tools = (await getCollection('tools')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || Number(b.data.editorsPick) - Number(a.data.editorsPick) || b.data.addedDate.valueOf() - a.data.addedDate.valueOf());
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const counts = new Map(VERTICALS.map((v) => [v.slug, tools.filter((t) => t.data.vertical === v.slug).length]));
const verticals = [...VERTICALS].sort((a, b) => (counts.get(b.slug) ?? 0) - (counts.get(a.slug) ?? 0));
---
<Base title="AI tools directory: reviews, comparisons and free listings" description={SITE.description}>
  <section class="hero">
    <p class="meta" style="margin:0 0 .85rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; font-size:.76rem; color:var(--accent);">Software directory, open to every category</p>
    <h1>{SITE.tagline}</h1>
    <p class="lead">Independent reviews and side by side comparisons of AI tools for finance, marketing, sales, support, engineering and the rest of the company. Any product can be listed for free. Growth services for the companies that build them.</p>
    <div class="row" style="margin-top:1.25rem;">
      <a class="btn" href="/tools/">Browse the tools</a>
      <a class="btn ghost" href="/submit-tool/">List your tool, free</a>
    </div>
    <div class="stats-bar">
      <div class="stat">
        <span class="stat-number">{tools.length}</span>
        <span class="stat-label">Tools reviewed</span>
      </div>
      <div class="stat">
        <span class="stat-number">{VERTICALS.length}</span>
        <span class="stat-label">Categories</span>
      </div>
      <div class="stat">
        <span class="stat-number">{posts.length}</span>
        <span class="stat-label">Articles</span>
      </div>
    </div>
  </section>

  <section class="section fade-in">
    <div class="row" style="justify-content:space-between; margin-bottom:1.25rem;">
      <h2 style="margin:0;">Browse by category</h2>
      <a href="/categories/" style="font-size:.9rem; font-weight:500;">All categories</a>
    </div>
    <div class="grid">
      {verticals.slice(0, 6).map((v) => {
        const n = counts.get(v.slug) ?? 0;
        return (
          <div class="card">
            <span class="pill">{n > 0 ? `${n} ${n === 1 ? 'tool' : 'tools'}` : 'Open for listings'}</span>
            <h3><a href={`/categories/${v.slug}/`}>{v.name}</a></h3>
            <p class="muted" style="flex:1; font-size:.93rem;">{v.blurb}</p>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section fade-in">
    <div class="row" style="justify-content:space-between; margin-bottom:1.25rem;">
      <h2 style="margin:0;">Latest tools</h2>
      <a href="/submit-tool/" style="font-size:.9rem; font-weight:500;">Submit yours, free</a>
    </div>
    <div class="grid">{tools.slice(0, 6).map((t) => <ToolCard tool={t} />)}</div>
    {tools.length > 6 && <p style="margin-top:1rem;"><a href="/tools/">View all {tools.length} tools</a></p>}
  </section>

  <section class="section fade-in">
    <div class="row" style="justify-content:space-between; margin-bottom:1.25rem;">
      <h2 style="margin:0;">From the blog</h2>
      <a href="/blog/" style="font-size:.9rem; font-weight:500;">All articles</a>
    </div>
    <div class="grid">{posts.slice(0, 3).map((p) => <PostCard post={p} />)}</div>
  </section>

  <section class="section fade-in">
    <div class="row" style="justify-content:space-between; margin-bottom:1.25rem;">
      <h2 style="margin:0;">Free resources</h2>
      <a href="/learn/" style="font-size:.9rem; font-weight:500;">Everything in Learn</a>
    </div>
    <div class="grid">
      <div class="card">
        <h3><a href="/learn/tool-evaluation-scorecard/">Tool evaluation scorecard</a></h3>
        <p class="muted" style="flex:1; font-size:.93rem;">Eight weighted criteria, up to three tools side by side. Set the weights before the demo and print the result for the purchase request.</p>
      </div>
      <div class="card">
        <h3><a href="/learn/software-cost-calculator/">Software cost calculator</a></h3>
        <p class="muted" style="flex:1; font-size:.93rem;">Seat growth, add-ons, implementation and the annual billing question, rolled into a three year total and a real cost per seat.</p>
      </div>
      <div class="card">
        <h3><a href="/learn/ai-vendor-security-checklist/">AI vendor security checklist</a></h3>
        <p class="muted" style="flex:1; font-size:.93rem;">The questions on training data, retention, SSO and exit that vendors go quiet on. Tick them off, copy them into your review.</p>
      </div>
    </div>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0; margin-bottom:1.25rem;">Work with us</h2>
    <div class="grid">
      <div class="card">
        <h3>Get in front of buyers</h3>
        <p class="muted" style="flex:1; font-size:.93rem;">Sponsored articles and featured listings, read by the people comparing tools before they buy.</p>
        <a href="/submit-tool/" style="font-size:.9rem; font-weight:500;">See advertising options</a>
      </div>
      <div class="card">
        <h3>Get cited by AI and ranked on Google</h3>
        <p class="muted" style="flex:1; font-size:.93rem;">Guest post placement, directory submissions, SEO content and LinkedIn ghostwriting, done for you.</p>
        <a href="/services/" style="font-size:.9rem; font-weight:500;">See growth services</a>
      </div>
      <div class="card">
        <h3>Share your expertise</h3>
        <p class="muted" style="flex:1; font-size:.93rem;">Practitioners and founders can publish free guest posts if they teach something real.</p>
        <a href="/write-for-us/" style="font-size:.9rem; font-weight:500;">Read the guidelines</a>
      </div>
    </div>
  </section>

  <section class="section fade-in">
    <Newsletter />
  </section>

</Base>
