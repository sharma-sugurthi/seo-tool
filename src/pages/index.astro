---
import Base from '../layouts/Base.astro';
import ToolRow from '../components/ToolRow.astro';
import ToolCard from '../components/ToolCard.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { SITE, REVIEW_SLA, INSTANT_PRICE, ADVERTISE_PRICES } from '../site.config';
import { VERTICALS } from '../data/taxonomy';
import { editorialRank, fmtDate, hasFreePlan } from '../lib/compare';
import { toneFor } from '../lib/brand';

/**
 * Directory-first landing page. Every number on it is computed from the published data at build time;
 * nothing is simulated. Three columns on desktop: browse rail, ranked lists, proof and offers rail.
 */
const all = await getCollection('tools');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const verdicts = await getCollection('comparisons');
const byId = new Map(all.map((t) => [t.id, t]));
const pairs = verdicts.map((c) => ({ id: c.id, a: byId.get(c.data.toolA), b: byId.get(c.data.toolB), winner: c.data.winner ? byId.get(c.data.winner) : undefined, reason: c.data.winnerReason, reviewedAt: c.data.reviewedAt })).filter((p) => p.a && p.b);

const topRated = [...all].sort(editorialRank).slice(0, 8);
const justAdded = [...all].sort((a, b) => b.data.addedDate.valueOf() - a.data.addedDate.valueOf() || a.data.name.localeCompare(b.data.name)).slice(0, 8);
const picks = all.filter((t) => t.data.editorsPick).sort(editorialRank).slice(0, 8);
const free = all.filter((t) => hasFreePlan(t.data)).sort(editorialRank).slice(0, 8);
const deals = all.filter((t) => t.data.deal).sort(editorialRank).slice(0, 8);
const verified = all.filter((t) => t.data.dataCheckedAt);
const comparePages = (() => { let n = 0; const byCat = new Map<string, number>(); all.forEach((t) => byCat.set(t.data.category, (byCat.get(t.data.category) ?? 0) + 1)); byCat.forEach((c) => (n += (c * (c - 1)) / 2)); return n + pairs.filter((p) => p.a!.data.category !== p.b!.data.category).length; })();
const altPages = all.filter((t) => all.filter((x) => x.data.category === t.data.category).length - 1 >= 3).length;
const counts = new Map(VERTICALS.map((v) => [v.slug, all.filter((t) => t.data.vertical === v.slug).length]));
const verticals = [...VERTICALS].sort((a, b) => (counts.get(b.slug) ?? 0) - (counts.get(a.slug) ?? 0));
const lastUpdated = new Date(Math.max(...all.flatMap((t) => [t.data.addedDate.getTime(), t.data.dataCheckedAt?.getTime() ?? 0])));
const pricingCounts = ['Free', 'Freemium', 'Paid', 'Enterprise'].map((p) => [p, all.filter((t) => t.data.pricing === p).length] as const);
const featuredPrice = ADVERTISE_PRICES.find((p) => p.name === 'Featured tool listing')!;
const sponsoredPrice = ADVERTISE_PRICES.find((p) => p.name === 'Sponsored article')!;
const tabs = [
  { key: 'top', label: 'Top rated', items: topRated, note: 'Editorial rating, then editor\'s pick. Paid placement never moves a tool here.' },
  { key: 'new', label: 'Just added', items: justAdded, note: 'Newest listings first, by the date they were published.' },
  { key: 'picks', label: "Editor's picks", items: picks, note: 'Tools we would recommend to a friend. Picked by us, never paid for.' },
  { key: 'free', label: 'Free plans', items: free, note: 'A permanent free plan according to the vendor\'s published pricing.' },
  ...(deals.length ? [{ key: 'deals', label: 'Deals', items: deals, note: 'Offers vendors attached to their listing. Not a ranking input.' }] : []),
];
const altTargets = [...all].sort(editorialRank).filter((t) => all.filter((x) => x.data.category === t.data.category).length - 1 >= 3).slice(0, 6);
---
<Base title="AI tools directory: reviews and comparisons" description={SITE.description}>
  <section class="home-hero">
    <p class="meta eyebrow">Independent software reviews. Finance and accounting first.</p>
    <h1>Software reviewed by people, compared on facts.</h1>
    <p class="lead">{all.length} tools across {verticals.filter((v) => (counts.get(v.slug) ?? 0) > 0).length} categories, each read by an editor before it is listed. Side-by-side comparisons built from the vendors' own pricing pages, alternatives ranked by rating alone, and every paid placement labelled.</p>
    <button type="button" class="home-search" data-search-open aria-label="Search the directory">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span>Search {all.length} tools, {comparePages} comparisons and every guide</span>
      <kbd class="key">/</kbd>
    </button>
    <div class="row home-cta">
      <a class="btn" href="/tools/">Browse the directory</a>
      <a class="btn ghost" href="/submit-tool/">List your tool, free</a>
      <span class="meta">Reviewed within {REVIEW_SLA}. Instant publish {INSTANT_PRICE}.</span>
    </div>
    <ul class="trust-strip" aria-label="What the directory holds">
      <li><b>{all.length}</b> reviews written by a person</li>
      <li><b>{comparePages}</b> compare pages from vendor data</li>
      <li><b>{pairs.length}</b> editorial verdicts</li>
      <li><b>{verified.length}</b> pricing checks logged{verified.length < all.length ? `, ${all.length - verified.length} to go` : ''}</li>
      <li><b>0</b> ratings for sale</li>
    </ul>
  </section>

  <div class="home-grid">
    <aside class="rail rail-left" aria-label="Browse">
      <section class="rail-block">
        <h2 class="rail-title">Browse by job</h2>
        <ul class="rail-list">
          {verticals.map((v) => (counts.get(v.slug) ?? 0) > 0 && (
            <li><a href={`/categories/${v.slug}/`}><span class="dot" style={`background:${toneFor(v.slug)}`}></span>{v.short}<span class="n">{counts.get(v.slug)}</span></a></li>
          ))}
          <li><a href="/categories/" class="more">All categories, including the open ones</a></li>
        </ul>
      </section>
      <section class="rail-block">
        <h2 class="rail-title">By pricing</h2>
        <ul class="rail-list">
          {pricingCounts.map(([p, n]) => <li><a href={`/tools/?pricing=${p}`}>{p}<span class="n">{n}</span></a></li>)}
        </ul>
      </section>
      <section class="rail-block">
        <h2 class="rail-title">Alternatives</h2>
        <ul class="rail-list">
          {altTargets.map((t) => <li><a href={`/tools/alternatives/${t.id}/`}>{t.data.name} alternatives</a></li>)}
          <li><a class="more" href="/tools/compare/">All comparisons</a></li>
        </ul>
      </section>
      <section class="rail-block">
        <h2 class="rail-title">For developers and AI assistants</h2>
        <p class="meta" style="margin:0 0 .4rem;">Free JSON API and an MCP server over the same data.</p>
        <a class="link-more" href="/api-reference/">API reference</a>
      </section>
    </aside>

    <main class="home-main">
      <div class="tabs" role="tablist" aria-label="Tool lists">
        {tabs.map((t, i) => <button type="button" role="tab" class={`tab${i === 0 ? ' on' : ''}`} id={`tab-${t.key}`} aria-controls={`panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.key}>{t.label}</button>)}
        <a class="tabs-more" href="/tools/">All {all.length} →</a>
      </div>
      {tabs.map((t, i) => (
        <section role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} class="tab-panel" hidden={i !== 0}>
          <p class="meta tab-note">{t.note}</p>
          <ol class="trows">{t.items.map((tool, n) => <ToolRow tool={tool} rank={n + 1} />)}</ol>
        </section>
      ))}

      {pairs.length > 0 && (
        <section class="home-section">
          <div class="section-head"><h2>Head to head</h2><a class="link-more" href="/tools/compare/">All {comparePages} comparisons</a></div>
          <ul class="vs-grid">
            {pairs.slice(0, 6).map((p) => (
              <li class="card vs-card">
                <a class="vs-pair" href={`/tools/compare/${p.id}/`}>{p.a!.data.name} <em>vs</em> {p.b!.data.name}</a>
                <p class="muted" style="margin:.35rem 0 0; font-size:.93rem;">{p.winner ? `Our call: ${p.winner.data.name}. ${p.reason ?? ''}` : 'No clear winner: it depends on your team.'}</p>
                {p.reviewedAt && <span class="meta">Reviewed {fmtDate(p.reviewedAt)}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="home-section">
        <div class="section-head"><h2>Categories</h2><a class="link-more" href="/categories/">Open categories are free to claim</a></div>
        <div class="cat-grid">
          {verticals.map((v) => {
            const n = counts.get(v.slug) ?? 0;
            const top = all.filter((t) => t.data.vertical === v.slug).sort(editorialRank).slice(0, 3).map((t) => t.data.name);
            return (
              <a class="cat-tile" href={`/categories/${v.slug}/`} style={`--tone:${toneFor(v.slug)}`}>
                <span class="cat-n">{n > 0 ? n : 'Open'}</span>
                <strong>{v.name}</strong>
                <span class="meta">{top.length ? top.join(', ') : v.categories.slice(0, 3).join(', ')}</span>
              </a>
            );
          })}
        </div>
      </section>
    </main>

    <aside class="rail rail-right" aria-label="About the directory">
      <section class="rail-block proof-card">
        <h2 class="rail-title">The directory in numbers</h2>
        <dl class="proof-dl">
          <div><dt>Tools reviewed</dt><dd>{all.length}</dd></div>
          <div><dt>Compare pages</dt><dd>{comparePages}</dd></div>
          <div><dt>Alternatives pages</dt><dd>{altPages}</dd></div>
          <div><dt>Editorial verdicts</dt><dd>{pairs.length}</dd></div>
          <div><dt>Vendor pricing checks</dt><dd>{verified.length}</dd></div>
          <div><dt>Last updated</dt><dd>{fmtDate(lastUpdated)}</dd></div>
        </dl>
        <p class="meta">Counted from the published database at build time. Traffic and backlink figures appear here once there are 30 days of them to show.</p>
      </section>

      <section class="rail-block offer-card">
        <h2 class="rail-title">List your tool</h2>
        <ul class="offer-list">
          <li><span>Free listing</span><b>$0</b></li>
          <li><span>Instant publish, live in 24h</span><b>{INSTANT_PRICE}</b></li>
          <li><span>Featured, 12 months</span><b>{featuredPrice.price}</b></li>
          <li><span>Sponsored article</span><b>{sponsoredPrice.price}</b></li>
        </ul>
        <p class="meta" style="margin:.25rem 0 .75rem;">Preview before you pay. Edit for free, forever. Paid links are tagged rel=sponsored, as Google requires.</p>
        <a class="btn" href="/submit-tool/" style="width:100%; justify-content:center;">Start a listing</a>
      </section>

      <section class="rail-block">
        <h2 class="rail-title">Directory package</h2>
        <p class="meta" style="margin:0 0 .5rem;">Manual submission to 62 directories, every domain rating published before you pay, indexed-link report at 30 days.</p>
        <a class="link-more" href="/directory-package/">See every directory and its DR</a>
      </section>

      {posts.length > 0 && (
        <section class="rail-block">
          <h2 class="rail-title">From the blog</h2>
          <ul class="rail-posts">
            {posts.slice(0, 3).map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="meta">{p.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span></li>)}
          </ul>
          <a class="link-more" href="/blog/">All articles</a>
        </section>
      )}

      <section class="rail-block">
        <h2 class="rail-title">Free tools for buyers</h2>
        <ul class="rail-posts">
          <li><a href="/learn/tool-evaluation-scorecard/">Evaluation scorecard</a></li>
          <li><a href="/learn/software-cost-calculator/">Three-year cost calculator</a></li>
          <li><a href="/learn/ai-vendor-security-checklist/">Vendor security checklist</a></li>
          <li><a href="/learn/month-end-close-checklist/">Month end close checklist</a></li>
        </ul>
      </section>
    </aside>
  </div>

  <section class="section how">
    <div class="section-head"><h2>How a listing works</h2><span class="meta">The same three steps for free and paid listings</span></div>
    <ol class="how-steps">
      <li><span class="how-n">1</span><h3>Submit</h3><p>Name, site, category, a tagline and a short description. You see the card exactly as it will appear before you send it, and before you pay for anything.</p></li>
      <li><span class="how-n">2</span><h3>A person reads it</h3><p>Within {REVIEW_SLA}. The editor checks the product exists and does what the listing says, trims the marketing words, and files it under the right category.</p></li>
      <li><span class="how-n">3</span><h3>Published with proof</h3><p>Your review page shows when it was listed, when pricing was last checked, the link type, and every compare and alternatives page it appears on. Edit it for free, forever.</p></li>
    </ol>
  </section>

  <section class="section">
    <div class="section-head"><h2>Latest reviews</h2><a class="link-more" href="/tools/">All {all.length} tools</a></div>
    <div class="grid reveal-stagger">{justAdded.slice(0, 6).map((t) => <ToolCard tool={t} />)}</div>
  </section>

  {posts.length > 0 && (
    <section class="section reveal">
      <div class="section-head"><h2>From the blog</h2><a class="link-more" href="/blog/">All articles</a></div>
      <div class="grid reveal-stagger">{posts.slice(0, 3).map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <section class="section reveal">
    <Newsletter />
  </section>

  <script>
    // Tabs: server-rendered panels, one visible at a time. Deep-linkable via #tab-<key>.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
    const panels = [...document.querySelectorAll<HTMLElement>('.tab-panel')];
    const show = (key: string) => {
      tabs.forEach((t) => { const on = t.dataset.tab === key; t.classList.toggle('on', on); t.setAttribute('aria-selected', String(on)); });
      panels.forEach((p) => (p.hidden = p.id !== `panel-${key}`));
    };
    tabs.forEach((t) => t.addEventListener('click', () => { show(t.dataset.tab!); history.replaceState(null, '', `#tab-${t.dataset.tab}`); }));
    const h = location.hash.replace('#tab-', '');
    if (h && tabs.some((t) => t.dataset.tab === h)) show(h);
  </script>
</Base>
