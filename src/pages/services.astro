---
import Base from '../layouts/Base.astro';
import PriceTable from '../components/PriceTable.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTENT_SERVICES, DISTRIBUTION_SERVICES } from '../site.config';

const faqs = [
  {
    q: 'How quickly will I see results?',
    a: 'Guest post links go live within 2 to 3 weeks. SEO content takes 2 to 4 months to move rankings meaningfully. AI citation improvements depend on model update cycles but typically surface within 6 to 8 weeks of new content being indexed.',
  },
  {
    q: 'Do I need to sign a long contract?',
    a: 'No. Every service is pay per deliverable or month to month. We keep clients by delivering results, not by locking them in. Bundle content and distribution and save 15 percent.',
  },
  {
    q: 'Where do the guest post links come from?',
    a: 'Real publications in your niche with organic traffic, vetted by hand. We share the site list before we write a word, and you pay per live link, not per attempt.',
  },
  {
    q: 'Can I see examples of your work?',
    a: 'Yes. On a discovery call we share anonymised examples of placements, LinkedIn content and SEO articles we have produced for similar companies. We also run this site as a live portfolio.',
  },
  {
    q: 'Do you offer an AI visibility audit?',
    a: 'Yes, and it is free with any order. Before we start we check how often ChatGPT, Perplexity, Gemini and Google AI Overviews mention you versus competitors, and which sources they cite. That check sets the targets for the work.',
  },
  {
    q: 'How do I pay?',
    a: 'The directory package is paid by card, Apple Pay or Google Pay at checkout and the receipt comes from Dodo Payments, our payment provider. Quoted work (content, placements, LinkedIn) is confirmed by email with a payment link the same day. No retainers, no long contracts.',
  },
  {
    q: 'What industries do you specialise in?',
    a: 'B2B software of any kind. Our deepest network is in finance, accounting and fintech, and we have placed and written for dev tools, HR, ecommerce and marketing products. On the kickoff call we show you the sites we already work with in your space.',
  },
];

const steps = [
  { title: 'Place your order', body: 'Buy the directory package directly, or send the order form for quoted work and get a payment link the same day.' },
  { title: 'Kickoff call', body: '30 minutes on your buyers, competitors and the questions they ask. We check where you already show up in AI answers.' },
  { title: 'Execution', body: 'We do the work. Anything published in your name or about your brand is shared for approval first.' },
  { title: 'Delivery report', body: 'Links live, content published, rankings and AI citations found, in a spreadsheet you own.' },
];
---
<Base title="Growth services for B2B SaaS: link building, directories, content and LinkedIn" description="Done-for-you guest post placement, directory and listicle submissions, SEO and GEO content, and LinkedIn ghostwriting for SaaS and AI software companies.">
  <section class="hero">
    <p class="meta" style="margin:0 0 .85rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; font-size:.76rem; color:var(--accent);">For SaaS and AI product teams</p>
    <h1>Get found on Google, LinkedIn and inside AI answers</h1>
    <p class="lead">Buyers now ask ChatGPT and Google's AI Overviews before they book a demo. Those answers are built from listicles, directories, review sites and expert content. We build that footprint for you.</p>
    <div class="row" style="margin-top:1rem;"><a class="btn" href="#order">Order now</a><a class="btn ghost" href="#how">How it works</a></div>
  </section>

  <section class="section fade-in">
    <div class="notice" style="margin-bottom: 2rem;">
      <strong>Open to any B2B software company.</strong> The directory started in finance, but the outreach, directory submissions and content work cover every niche: dev tools, fintech, ecommerce, HR, martech and the rest. We get products listed on 100+ directories and ranking on Google.
    </div>
    <div class="service-category">
      <p class="meta" style="margin:0 0 .25rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; font-size:.76rem; color:var(--accent);">Distribution</p>
      <h2 style="margin-top:0">We place, you get links</h2>
      <p class="muted" style="margin-bottom:1rem;">Pay per live link, not per attempt. Prices shown while the directory is under 10K monthly visitors &mdash; your rate is locked in permanently once you order.</p>
      <PriceTable items={DISTRIBUTION_SERVICES} ctaHref="#order" ctaLabel="Order" />
    </div>
  </section>

  <section class="section fade-in">
    <div class="service-category">
      <p class="meta" style="margin:0 0 .25rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; font-size:.76rem; color:var(--accent);">Content</p>
      <h2 style="margin-top:0">We write, you publish</h2>
      <p class="muted" style="margin-bottom:1rem;">Pay per deliverable, no retainers. One free revision on every piece. Prices shown while the directory is under 10K monthly visitors.</p>
      <PriceTable items={CONTENT_SERVICES} ctaHref="#order" ctaLabel="Order" />
    </div>
  </section>

  <section class="section fade-in">
    <div class="notice">
      <strong>Bundle and save.</strong> Order from both Content and Distribution and get 15% off the total. Just mention it in your order and we will apply the discount to your invoice.
    </div>
    <div class="notice" style="margin-top:1rem;">
      <strong>Directory package deliverable.</strong> You receive a spreadsheet within 7 business days: every directory name, URL, submission date and live status. That is the exact report, every time.
    </div>
  </section>

  <section class="section fade-in" id="how">
    <h2 style="margin-top:0">How it works</h2>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="card">
          <div class="step-num">{i + 1}</div>
          <h3>{s.title}</h3>
          <p class="muted" style="font-size:.93rem;">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">What we will not do</h2>
    <ul style="padding-left:1.25rem; display:grid; gap:.5rem;">
      <li>Fake reviews, vote manipulation or astroturfing that breaks a community's rules. It gets accounts banned and brands named in threads.</li>
      <li>Private blog networks or spun content. Links from sites with no real traffic do not move rankings in 2026.</li>
      <li>Promise a ranking or a number of AI citations. We show you the work and the movement every month.</li>
    </ul>
  </section>

  <section class="section fade-in">
    <h2 style="margin-top:0">Frequently asked questions</h2>
    <div class="faq-list">
      {faqs.map(({ q, a }) => (
        <details class="faq">
          <summary>{q}</summary>
          <div class="faq-body"><p>{a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <section class="section fade-in" id="order">
    <h2 style="margin-top:0">Place your order</h2>
    <p class="muted" style="margin-bottom:1rem;">Tell us what you need and we will follow up within one business day to confirm scope and next steps.</p>
    <ContactForm kind="service-order" options={['SEO and GEO content', 'LinkedIn ghostwriting', 'Guest post placement', 'Directory and listicle package', 'Bundle (content + distribution)']} optionsLabel="Which service?" placeholder="Which service, the product or pages to promote, anchor text if you have it, budget and timeline." />
  </section>
</Base>
