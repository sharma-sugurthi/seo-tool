---
import Base from '../layouts/Base.astro';
import PriceTable from '../components/PriceTable.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, CONTENT_SERVICES, DISTRIBUTION_SERVICES, FIXED_PRICE_ITEMS, BUNDLE_DISCOUNT } from '../site.config';

const faqs = [
  {
    q: 'How quickly will I see results?',
    a: 'Guest post links go live within two to three weeks. SEO content takes two to four months to move rankings. AI citations follow the model update cycles and typically show up six to eight weeks after new content is indexed.',
  },
  {
    q: 'Is there a contract?',
    a: 'No. Every service is priced per deliverable or per month. Stop whenever you like.',
  },
  {
    q: 'Where do the guest post links come from?',
    a: 'Publications in your niche with organic traffic, vetted by hand. You see the site list before a word is written, and you pay per live link, not per attempt.',
  },
  {
    q: 'Can I see examples?',
    a: 'On the kickoff call we walk through anonymised placements, LinkedIn content and SEO articles for companies like yours. This site is the live portfolio: the reviews, the compare pages and the rankings are the work.',
  },
  {
    q: 'What is the AI visibility audit?',
    a: 'Before any work starts we check how often ChatGPT, Perplexity, Gemini and Google AI Overviews mention you against your competitors, and which sources they cite. That sets the targets. It is included with every order.',
  },
  {
    q: 'How do I pay?',
    a: 'Fixed-price items check out below by card, Apple Pay or Google Pay; the receipt comes from Dodo Payments, our merchant of record. Quoted work is confirmed with a scope and a payment link the same business day.',
  },
  {
    q: 'Which industries?',
    a: 'B2B software of any kind. The deepest network is in finance, accounting and fintech; we have also placed and written for developer tools, HR, ecommerce and marketing products. On the kickoff call you see the sites we already work with in your space.',
  },
];
const steps = [
  { title: 'Order', body: 'Fixed-price items check out below. Quoted work gets a scope and a payment link the same business day.' },
  { title: 'Kickoff', body: 'Thirty minutes on your buyers, competitors and the questions they ask. We check where you already show up in AI answers.' },
  { title: 'Execution', body: 'Anything published in your name or about your brand is shared for approval first.' },
  { title: 'Report', body: 'Links live, content published, rankings and AI citations found, in a spreadsheet you own.' },
];
const money = (cents: number) => `$${(cents / 100).toLocaleString('en-US')}`;
---
<Base title="Growth services for B2B software: links, directories, content and LinkedIn" description="Guest post placement, directory and listicle submissions, SEO and GEO content and LinkedIn ghostwriting for SaaS and AI software companies. Priced per deliverable, paid only when live.">
  <section class="hero">
    <p class="meta eyebrow">For SaaS and AI product teams</p>
    <h1>Get found on Google, LinkedIn and inside AI answers</h1>
    <p class="lead">Buyers ask ChatGPT and Google's AI Overviews before they book a demo. Those answers are built from directories, listicles, review sites and expert content. We build that footprint for you: priced per deliverable, site lists shared before anything is written, links paid only once they are live.</p>
    <div class="row" style="margin-top:1rem;"><a class="btn" href="#order">Build your order</a><a class="btn ghost" href="#how">How it works</a></div>
  </section>

  <section class="section reveal">
    <div class="section-head"><div><p class="meta eyebrow" style="margin-bottom:.35rem;">Distribution</p><h2>Placements on sites people actually read</h2></div></div>
    <p class="muted" style="margin:0 0 1.25rem; max-width:44rem;">Real publications with organic traffic, vetted by hand. You approve the list first and pay per live link.</p>
    <PriceTable items={DISTRIBUTION_SERVICES} ctaHref="#order" ctaLabel="Order" />
  </section>

  <section class="section reveal">
    <div class="section-head"><div><p class="meta eyebrow" style="margin-bottom:.35rem;">Content</p><h2>Written for search engines and the models that read them</h2></div></div>
    <p class="muted" style="margin:0 0 1.25rem; max-width:44rem;">Keyword and AI citation research first, then the piece, fact-checked, with schema and meta tags. One free revision on every deliverable.</p>
    <PriceTable items={CONTENT_SERVICES} ctaHref="#order" ctaLabel="Order" />
  </section>

  <section class="section reveal" id="order">
    <div class="section-head"><h2>Build your order</h2><span class="meta">Fixed-price items. Checkout in one step.</span></div>
    <form class="builder" id="builder" action={`${SITE.apiBase}/checkout/order-builder`} method="POST">
      <div class="builder-items">
        {FIXED_PRICE_ITEMS.map((it) => (
          <div class="b-item" data-key={it.key} data-cents={it.cents}>
            <span class="b-check">{it.max > 1
              ? <input type="number" name={`qty_${it.key}`} min="0" max={it.max} value="0" class="qty" aria-label={`Number of ${it.name.toLowerCase()}`} />
              : <input type="checkbox" name={`item_${it.key}`} value="1" />}</span>
            <span class="b-body">
              <span class="b-name">{it.name} <b>{money(it.cents)} <small>{it.unit}</small></b></span>
              <span class="b-desc">{it.description}</span>
              {it.addon && (
                <label class="chk-row b-addon"><input type="checkbox" name={it.addon.key} value="1" data-addon-cents={it.addon.cents} /> {it.addon.label} <b>+{money(it.addon.cents)} {it.addon.unit}</b></label>
              )}
            </span>
          </div>
        ))}
      </div>
      <div class="card builder-summary">
        <h3>Your order</h3>
        <ul class="summary-lines" id="summary-lines"><li class="muted">Nothing selected yet.</li></ul>
        <div class="summary-row"><span>Subtotal</span><b id="sum-sub">$0</b></div>
        <div class="summary-row discount" id="sum-discount-row" hidden><span>Bundle discount, {BUNDLE_DISCOUNT.percent}%</span><b id="sum-discount">$0</b></div>
        <div class="summary-row total"><span>Total</span><b id="sum-total">$0</b></div>
        <p class="meta" id="bundle-hint">Add {BUNDLE_DISCOUNT.minItems} different items and {BUNDLE_DISCOUNT.percent}% comes off the whole order at checkout.</p>
        <div class="stack" style="margin-top:1rem;">
          <label>Company <input name="company" required maxlength="80" /></label>
          <label>Website <input type="url" name="website" required placeholder="https://" /></label>
          <label>Work email <input type="email" name="email" required autocomplete="email" /></label>
          <label>Your name <input name="name" autocomplete="name" /></label>
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          {SITE.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey}></div>}
          <button class="btn" type="submit" id="checkout-btn" disabled>Checkout</button>
          <p class="meta" style="margin:0;">Card, Apple Pay or Google Pay through Dodo Payments. Listings and articles are completed from private links after payment. Declined listings are refunded in full.</p>
        </div>
      </div>
    </form>
  </section>

  <section class="section reveal" id="quote">
    <div class="section-head"><h2>Quoted work</h2><span class="meta">Guest posts, SEO content, LinkedIn</span></div>
    <p class="muted" style="margin:0 0 1.25rem; max-width:44rem;">These are scoped to your product and your target sites. Send the brief; a scope and a payment link follow the same business day. Orders that combine content and distribution get the {BUNDLE_DISCOUNT.percent}% bundle discount on the invoice.</p>
    <ContactForm kind="service-order" options={['Guest post placement', 'SEO and GEO content', 'LinkedIn ghostwriting', 'Content and distribution together']} optionsLabel="Which service?" placeholder="The product or pages to promote, target sites or topics if you have them, anchor text, budget and timeline." submitLabel="Send the brief" />
  </section>

  <section class="section reveal" id="how">
    <h2 style="margin-top:0">How it works</h2>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="card"><div class="step-num">{i + 1}</div><h3>{s.title}</h3><p class="muted" style="font-size:.93rem;">{s.body}</p></div>
      ))}
    </div>
  </section>

  <section class="section reveal">
    <h2 style="margin-top:0">What we will not do</h2>
    <ul style="padding-left:1.25rem; display:grid; gap:.5rem;">
      <li>Fake reviews, vote manipulation or astroturfing that breaks a community's rules. It gets accounts banned and brands named in threads.</li>
      <li>Private blog networks or spun content. Links from sites with no real traffic do not move rankings.</li>
      <li>Promise a ranking or a number of AI citations. You see the work and the movement every month.</li>
    </ul>
  </section>

  <section class="section reveal">
    <h2 style="margin-top:0">Questions</h2>
    <div class="faq-list">
      {faqs.map(({ q, a }) => (
        <details class="faq"><summary>{q}</summary><div class="faq-body"><p>{a}</p></div></details>
      ))}
    </div>
  </section>

  <script type="application/json" id="bundle-data" set:html={JSON.stringify(BUNDLE_DISCOUNT)} />
  <script>
    const bundle: { percent: number; minItems: number } = JSON.parse(document.getElementById('bundle-data')?.textContent || '{"percent":0,"minItems":99}');
    const form = document.getElementById('builder') as HTMLFormElement;
    const lines = document.getElementById('summary-lines')!;
    const sub = document.getElementById('sum-sub')!, disc = document.getElementById('sum-discount')!, discRow = document.getElementById('sum-discount-row')!, total = document.getElementById('sum-total')!, hint = document.getElementById('bundle-hint')!;
    const btn = document.getElementById('checkout-btn') as HTMLButtonElement;
    const money = (c: number) => `$${(c / 100).toLocaleString('en-US', { minimumFractionDigits: c % 100 ? 2 : 0, maximumFractionDigits: 2 })}`;
    function recalc() {
      let subtotal = 0; const distinct = new Set<string>(); const out: string[] = [];
      form.querySelectorAll<HTMLElement>('.b-item').forEach((item) => {
        const cents = Number(item.dataset.cents); const key = item.dataset.key!;
        const qtyEl = item.querySelector<HTMLInputElement>('.qty'); const chk = item.querySelector<HTMLInputElement>('input[type=checkbox][name^=item_]');
        const qty = qtyEl ? Math.max(0, Math.min(Number(qtyEl.max), Number(qtyEl.value) || 0)) : chk?.checked ? 1 : 0;
        const addon = item.querySelector<HTMLInputElement>('input[data-addon-cents]');
        if (addon) addon.disabled = qty === 0;
        if (!qty) return;
        distinct.add(key); subtotal += cents * qty;
        const name = item.querySelector('.b-name')!.childNodes[0].textContent!.trim();
        out.push(`<li><span>${qty > 1 ? `${qty} x ` : ''}${name}</span><b>${money(cents * qty)}</b></li>`);
        if (addon?.checked) { const ac = Number(addon.dataset.addonCents) * qty; subtotal += ac; out.push(`<li><span>${qty > 1 ? `${qty} x ` : ''}written by us</span><b>${money(ac)}</b></li>`); }
      });
      const discount = distinct.size >= bundle.minItems ? Math.round(subtotal * bundle.percent / 100) : 0;
      lines.innerHTML = out.join('') || '<li class="muted">Nothing selected yet.</li>';
      sub.textContent = money(subtotal); disc.textContent = `-${money(discount)}`; discRow.hidden = !discount; total.textContent = money(subtotal - discount);
      hint.textContent = discount ? `${bundle.percent}% bundle discount applied at checkout.` : distinct.size === 1 ? `Add one more different item and ${bundle.percent}% comes off the whole order.` : `Add ${bundle.minItems} different items and ${bundle.percent}% comes off the whole order at checkout.`;
      btn.disabled = subtotal === 0;
      btn.textContent = subtotal ? `Checkout, ${money(subtotal - discount)}` : 'Checkout';
    }
    form.addEventListener('input', recalc); form.addEventListener('change', recalc); recalc();
    // Clicking anywhere on an item row toggles it (inputs and the add-on keep their own behaviour)
    form.querySelectorAll<HTMLElement>('.b-item').forEach((item) => item.addEventListener('click', (e) => {
      if ((e.target as Element).closest('input, .b-addon, a')) return;
      const chk = item.querySelector<HTMLInputElement>('input[type=checkbox][name^=item_]'); const qty = item.querySelector<HTMLInputElement>('.qty');
      if (chk) chk.checked = !chk.checked; else if (qty) qty.value = Number(qty.value) ? '0' : '1';
      recalc();
    }));
    // "Order" buttons on the price cards jump here and pre-tick the matching item
    document.querySelectorAll<HTMLAnchorElement>('a[href="#order"][data-item]').forEach((a) => a.addEventListener('click', () => {
      const el = form.querySelector<HTMLInputElement>(`[name="item_${a.dataset.item}"], [name="qty_${a.dataset.item}"]`);
      if (el) { if (el.type === 'checkbox') el.checked = true; else if (!Number(el.value)) el.value = '1'; recalc(); }
    }));
  </script>
</Base>
