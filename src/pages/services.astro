---
import Base from '../layouts/Base.astro';
import PriceTable from '../components/PriceTable.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, CONTENT_SERVICES, DISTRIBUTION_SERVICES, FIXED_PRICE_ITEMS } from '../site.config';
const directoryItem = FIXED_PRICE_ITEMS[0];

const faqs = [
  {
    q: 'How quickly will I see results?',
    a: 'Guest post links go live within two to three weeks. SEO content takes two to four months to move rankings. AI citations follow the model update cycles and typically show up six to eight weeks after new content is indexed.',
  },
  {
    q: 'Is there a contract?',
    a: 'No. Every service is priced per deliverable or per month. Stop whenever you like.',
  },
  {
    q: 'Where do the guest post links come from?',
    a: 'Publications in your niche with organic traffic, vetted by hand. You see the site list before a word is written, and you pay per live link, not per attempt.',
  },
  {
    q: 'Can I see examples?',
    a: 'On the kickoff call we walk through anonymised placements, LinkedIn content and SEO articles for companies like yours. This site is the live portfolio: the reviews, the compare pages and the rankings are the work.',
  },
  {
    q: 'What is the AI visibility audit?',
    a: 'Before any work starts we check how often ChatGPT, Perplexity, Gemini and Google AI Overviews mention you against your competitors, and which sources they cite. That sets the targets. It is included with every order.',
  },
  {
    q: 'How do I pay?',
    a: 'Fixed-price items check out below by card, Apple Pay or Google Pay; the receipt comes from Dodo Payments, our merchant of record. Quoted work is confirmed with a scope and a payment link the same business day.',
  },
  {
    q: 'Which industries?',
    a: 'B2B software of any kind. The deepest network is in finance, accounting and fintech; we have also placed and written for developer tools, HR, ecommerce and marketing products. On the kickoff call you see the sites we already work with in your space.',
  },
];
const steps = [
  { title: 'Kickoff & Strategy', body: 'We jump on a 30-minute call to understand your ideal buyers, your top competitors, and the questions your customers ask before buying.' },
  { title: 'Visibility Audit', body: 'We run a deep audit to see where you already show up in ChatGPT, Perplexity, and Google AI Overviews, setting the baseline.' },
  { title: 'Execution & Approval', body: 'We find the target sites and write the drafts. You see and approve every site and every word before anything goes live.' },
  { title: 'Live Reporting', body: 'You get a live, private dashboard showing every published link, content piece, and ranking movement in real-time.' },
];
const money = (cents: number) => `$${(cents / 100).toLocaleString('en-US')}`;
---
<Base title="Growth services for B2B software: links, directories, content and LinkedIn" description="Guest post placement, directory and listicle submissions, SEO and GEO content and LinkedIn ghostwriting for SaaS and AI software companies. Priced per deliverable, paid only when live.">
  <section class="hero">
    <p class="meta eyebrow">For SaaS and AI product teams</p>
    <h1>Get found on Google, LinkedIn and inside AI answers</h1>
    <p class="lead">Buyers ask ChatGPT and Google's AI Overviews before they book a demo. Those answers are built from directories, listicles, review sites and expert content. We build that footprint for you: priced per deliverable, site lists shared before anything is written, links paid only once they are live.</p>
    <div class="row" style="margin-top:1rem;"><a class="btn" href="#quote">Get a quote</a><a class="btn ghost" href="#how">How it works</a></div>
  </section>

  <section class="section reveal">
    <div class="section-head"><div><p class="meta eyebrow" style="margin-bottom:.35rem;">Distribution</p><h2>Placements on sites people actually read</h2></div></div>
    <p class="muted" style="margin:0 0 1.25rem; max-width:44rem;">Real publications with organic traffic, vetted by hand. You approve the list first and pay per live link.</p>
    <PriceTable items={DISTRIBUTION_SERVICES} ctaHref="#quote" ctaLabel="Get a quote" ctaDataAttr="data-service" />
  </section>

  <section class="section reveal">
    <div class="section-head"><div><p class="meta eyebrow" style="margin-bottom:.35rem;">Content</p><h2>Written for search engines and the models that read them</h2></div></div>
    <p class="muted" style="margin:0 0 1.25rem; max-width:44rem;">Keyword and AI citation research first, then the piece, fact-checked, with schema and meta tags. One free revision on every deliverable.</p>
    <PriceTable items={CONTENT_SERVICES} ctaHref="#quote" ctaLabel="Get a quote" ctaDataAttr="data-service" />
  </section>

  {/* ── Directory info modal ── */}
  <dialog id="dir-modal" style="max-width:32rem;width:90%;border-radius:12px;border:1px solid var(--border);padding:2rem;background:var(--surface);color:var(--text);">
    <button id="dir-modal-close" type="button" aria-label="Close" style="float:right;background:none;border:none;font-size:1.4rem;cursor:pointer;color:var(--muted);line-height:1;">&times;</button>
    <h3 style="margin-top:0;">How the directory package works</h3>
    <dl style="display:grid;gap:1rem;margin:0;">
      <div><dt style="font-weight:600;">What you get</dt><dd class="muted" style="margin:.25rem 0 0;">A private Google Sheet updated in real-time as each submission goes live. Columns: directory name, domain rating, category, submission date, live URL, and status.</dd></div>
      <div><dt style="font-weight:600;">What we check before submitting</dt><dd class="muted" style="margin:.25rem 0 0;">Every directory has real organic traffic (verified in Ahrefs), accepts your category, and does not charge a recurring fee to stay listed. No link farms.</dd></div>
      <div><dt style="font-weight:600;">After purchase</dt><dd class="muted" style="margin:.25rem 0 0;">You get an email with a short intake form (tool name, website, tagline). We start submissions the same business day we receive it.</dd></div>
    </dl>
    <a class="btn" href={`${SITE.apiBase}/checkout/direct?item=directory`} style="margin-top:1.5rem;display:inline-block;">Buy now - {money(directoryItem.cents)}</a>
  </dialog>

  <section class="section reveal" id="quote">
    <div class="section-head"><h2>Get a quote</h2><span class="meta">Brief in, scope and price out within one business day</span></div>
    <p class="muted" style="margin:0 0 1.25rem; max-width:44rem;">No pitch calls, no PDF decks. Send your brief below and you get a fixed scope, a target site list (for placements), and a payment link the same business day.</p>
    <ContactForm kind="service-order" />
  </section>

  <section class="section reveal" id="how">
    <h2 style="margin-top:0">How it works</h2>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="card"><div class="step-num">{i + 1}</div><h3>{s.title}</h3><p class="muted" style="font-size:.93rem;">{s.body}</p></div>
      ))}
    </div>
  </section>

  <section class="section reveal">
    <div class="card" style="border:1px solid var(--warn-border, #e8d48a); background:var(--warn, #fdf7e3);">
      <h2 style="margin-top:0; color:var(--text);">The Lantle Guarantee: What we will never do</h2>
      <ul style="padding-left:1.25rem; display:grid; gap:.5rem; margin-bottom:0; color:var(--text);">
        <li><b>Fake reviews or vote manipulation:</b> No astroturfing that breaks a community's rules. It gets accounts banned and brands named in threads.</li>
        <li><b>Private blog networks (PBNs):</b> No spun content or junk links. Links from sites with no real traffic do not move rankings.</li>
        <li><b>Fake guarantees:</b> We will not promise an exact ranking position or a specific number of AI citations. You see the work and the organic movement every month.</li>
      </ul>
    </div>
  </section>

  <section class="section reveal">
    <h2 style="margin-top:0">Questions</h2>
    <div class="faq-list">
      {faqs.map(({ q, a }) => (
        <details class="faq"><summary>{q}</summary><div class="faq-body"><p>{a}</p></div></details>
      ))}
    </div>
  </section>

  <script>
    // Auto-select service in the quote form when a pricing card's "Get a quote" button is clicked
    document.querySelectorAll<HTMLAnchorElement>('a[href="#quote"][data-service]').forEach((a) =>
      a.addEventListener('click', () => {
        const sel = document.getElementById('quote-service') as HTMLSelectElement | null;
        if (sel && a.dataset.service) sel.value = a.dataset.service;
        const qty = document.getElementById('placement-qty-row') as HTMLElement | null;
        if (qty) qty.hidden = a.dataset.service !== 'Guest post outreach and placement';
      })
    );

    // Directory info modal
    const modal = document.getElementById('dir-modal') as HTMLDialogElement | null;
    document.getElementById('dir-modal-close')?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  </script>
</Base>
