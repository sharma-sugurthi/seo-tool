---
import { SITE } from '../site.config';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>500: Internal Server Error | {SITE.title}</title>
  <style>
    body {
      margin: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f6f8f6;
      color: #111c18;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
    }
    .container { padding: 2rem; max-width: 32rem; }
    h1 { font-size: 2rem; margin: 1rem 0 0.5rem; letter-spacing: -0.02em; }
    p { color: #566058; line-height: 1.6; font-size: 1.05rem; }
    svg { color: #eab308; }
  </style>
</head>
<body>
  <div class="container">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
      <line x1="12" y1="9" x2="12" y2="13"></line>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <h1>This one is on us</h1>
    <p>We are experiencing an unexpected network or server issue. We are very sorry for the disruption. Please check your connection or try again in a few minutes.</p>
  </div>
</body>
</html>
