---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../site.config';
import { getVertical } from '../../data/taxonomy';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((t) => ({ params: { slug: t.id }, props: { tool: t } }));
}
const { tool } = Astro.props;
const d = tool.data;
const v = getVertical(d.vertical);
const { Content } = await render(tool);
// Paid (featured) listings get a dofollow link. Free listings are nofollow.
const rel = d.featured ? 'noopener' : 'nofollow noopener';
const fullStars = d.rating ?? 0;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: d.name,
  url: d.website,
  applicationCategory: 'BusinessApplication',
  description: d.tagline,
  offers: { '@type': 'Offer', price: d.pricing === 'Free' ? '0' : undefined, priceCurrency: 'USD' },
  // A single editorial rating is a Review, not an AggregateRating (which implies many user ratings).
  ...(d.rating
    ? {
        review: {
          '@type': 'Review',
          reviewRating: { '@type': 'Rating', ratingValue: d.rating, bestRating: 5 },
          author: { '@type': 'Organization', name: SITE.name },
        },
      }
    : {}),
  ...(d.thumbnail ? { image: new URL(d.thumbnail, Astro.site).toString() } : {}),
};

// Similar tools: same category first, then the rest of the vertical
const allTools = await getCollection('tools');
const rank = (a: any, b: any) => Number(b.data.featured) - Number(a.data.featured) || Number(b.data.editorsPick) - Number(a.data.editorsPick);
const sameCategory = allTools.filter((t) => t.data.category === d.category && t.id !== tool.id).sort(rank);
const sameVertical = allTools.filter((t) => t.data.vertical === d.vertical && t.data.category !== d.category && t.id !== tool.id).sort(rank);
const similar = [...sameCategory, ...sameVertical].slice(0, 3);
---
<Base title={`${d.name} review: ${d.tagline}`} description={`${d.name} for ${d.category.toLowerCase()}. ${d.tagline} Pricing: ${d.pricing}. Best for ${d.bestFor}.`} jsonLd={jsonLd} image={d.thumbnail}>
  <article class="section prose">
    <p class="meta"><a href="/tools/">Tools</a> / <a href={`/categories/${v.slug}/`}>{v.name}</a> / {d.category}</p>
    <div class="row">
      <span class="pill">{d.category}</span>
      {d.featured && <span class="pill warn">Featured listing (paid)</span>}
      {!d.featured && d.editorsPick && <span class="pill">Editor's pick (not paid)</span>}
    </div>
    <h1>{d.name}</h1>
    <p class="lead muted">{d.tagline}</p>
    {d.thumbnail && (
      <figure class="tool-hero-img">
        <img src={d.thumbnail} alt={`${d.name} screenshot`} width="1200" height="534" />
      </figure>
    )}
    <div class="kpis">
      <div class="card">
        <span class="meta">Pricing</span>
        <strong>{d.pricing}</strong>
      </div>
      <div class="card">
        <span class="meta">Best for</span>
        <strong style="font-size:1.05rem">{d.bestFor}</strong>
      </div>
      {d.rating && (
        <div class="card">
          <span class="meta">Our rating</span>
          <div class="stars" style="font-size:1.2rem;" aria-label={`Rating: ${d.rating} out of 5`}>
            {[1,2,3,4,5].map((i) => (
              <span class={`star ${i <= fullStars ? 'filled' : ''}`}>★</span>
            ))}
          </div>
        </div>
      )}
    </div>
    <p style="margin-top:1.25rem"><a class="btn" href={d.website} rel={rel} target="_blank">Visit {d.name} →</a></p>
    <Content />
    <hr />
    <p class="meta">Listing added {d.addedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}. Spotted an error? <a href={`mailto:${SITE.email}`}>Tell us</a>. Want this listing featured? <a href="/submit-tool/">See options</a>.</p>
  </article>

  {similar.length > 0 && (
    <section class="section fade-in">
      <div class="related-section">
        <h3>Similar tools in {sameCategory.length > 0 ? d.category : v.name}</h3>
        <div class="grid">{similar.map((t) => <ToolCard tool={t} />)}</div>
      </div>
    </section>
  )}

  <section class="section fade-in" style="text-align:center;">
    <div class="row" style="justify-content:center;">
      <a class="btn ghost" href={`/tools/alternatives/${tool.id}/`}>Alternatives to {d.name}</a>
      {sameCategory.length > 0 && sameCategory.slice(0, 1).map((t) => {
        const [first, second] = [tool.id, t.id].sort();
        return <a class="btn ghost" href={`/tools/compare/${first}-vs-${second}/`}>{d.name} vs {t.data.name}</a>;
      })}
    </div>
  </section>

  <section class="section fade-in">
    <Newsletter />
  </section>
</Base>
