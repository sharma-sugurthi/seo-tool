---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../site.config';
import { getVertical } from '../../data/taxonomy';
import { deployCell, fmtDate, freeCell, pairPath, priceCell, trialCell, editorialRank } from '../../lib/compare';
import { breadcrumbList, metaDescription, priceValue } from '../../lib/schema';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((t) => ({ params: { slug: t.id }, props: { tool: t } }));
}
const { tool } = Astro.props;
const d = tool.data;
const v = getVertical(d.vertical);
const { Content } = await render(tool);
// Paid (featured) listings get a followed link tagged rel="sponsored", which Google requires for paid placement.
// Free listings are nofollow. Never emit an untagged followed link to a paying customer: that is a link-scheme penalty risk for the whole domain.
const rel = d.featured ? 'sponsored noopener' : 'nofollow noopener';
const fullStars = d.rating ?? 0;
const year = new Date().getFullYear();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
// Offers: a real number when we have one (free, or a parsed starting price); otherwise no Offer at all. An Offer without a
// price is a Rich Results error, which is what the previous template emitted for every paid tool.
const price = d.pricing === 'Free' ? 0 : priceValue(d.startingPrice);
const offers = price != null ? { offers: { '@type': 'Offer', price: String(price), priceCurrency: 'USD', ...(d.startingPrice && price > 0 ? { description: d.startingPrice } : {}), availability: 'https://schema.org/InStock' } } : {};
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: d.name,
  url: d.website,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: d.category,
  operatingSystem: d.platforms.length ? d.platforms.join(', ') : 'Web',
  description: d.tagline,
  ...(d.keyFeatures.length ? { featureList: d.keyFeatures } : {}),
  datePublished: d.addedDate.toISOString().slice(0, 10),
  dateModified: (d.dataCheckedAt ?? d.addedDate).toISOString().slice(0, 10),
  mainEntityOfPage: pageUrl,
  ...offers,
  // A single editorial rating is a Review, not an AggregateRating (which implies many user ratings).
  ...(d.rating
    ? {
        review: {
          '@type': 'Review',
          reviewRating: { '@type': 'Rating', ratingValue: d.rating, bestRating: 5 },
          author: { '@type': 'Organization', name: SITE.name },
        },
      }
    : {}),
  ...(d.thumbnail ? { image: new URL(d.thumbnail, Astro.site).toString() } : {}),
}, breadcrumbList(Astro.site, [{ name: 'Tools', path: '/tools/' }, { name: v.name, path: `/categories/${v.slug}/` }, { name: d.name, path: Astro.url.pathname }])];

// Similar tools: same category first, then the rest of the vertical
const allTools = await getCollection('tools');
const rank = (a: any, b: any) => Number(b.data.featured) - Number(a.data.featured) || Number(b.data.editorsPick) - Number(a.data.editorsPick);
const sameCategory = allTools.filter((t) => t.data.category === d.category && t.id !== tool.id).sort(rank);
const sameVertical = allTools.filter((t) => t.data.vertical === d.vertical && t.data.category !== d.category && t.id !== tool.id).sort(rank);
const similar = [...sameCategory, ...sameVertical].slice(0, 4);
// Compare links use the editorial ranking (rating, then editor's pick), never paid placement.
const comparePeers = [...sameCategory].sort(editorialRank).slice(0, 3);
// "About this listing": the facts a founder checks before paying and a buyer checks before trusting. All real, all from the data.
const comparePages = sameCategory.length;
const altPagesListedOn = sameCategory.length; // every same-category peer's alternatives page lists this tool
const linkType = d.featured ? 'Followed link, tagged rel="sponsored" (paid placement)' : 'Nofollow link (free listing)';
const facts: [string, string][] = [
  ...(d.startingPrice || d.pricing === 'Free' || d.pricing === 'Enterprise' ? [['Starting price', priceCell(d)] as [string, string]] : []),
  ...(d.freeTier != null || d.pricing === 'Free' ? [['Free plan', freeCell(d)] as [string, string]] : []),
  ...(d.trialDays != null ? [['Free trial', trialCell(d)] as [string, string]] : []),
  ...(d.deployment ? [['Deployment', deployCell(d)] as [string, string]] : []),
  ...(d.platforms.length ? [['Platforms', d.platforms.join(', ')] as [string, string]] : []),
];
---
<Base title={`${d.name} review (${year}): pricing, pros and cons`} description={metaDescription(`${d.name} review: ${d.tagline} ${d.pricing}${d.startingPrice ? `, from ${d.startingPrice}` : ''}. Best for ${d.bestFor}.`)} jsonLd={jsonLd} image={d.thumbnail}>
  <div class="section tool-layout">
    <article class="prose tool-content">
      <nav class="meta" aria-label="Breadcrumb"><a href="/tools/">Tools</a> / <a href={`/categories/${v.slug}/`}>{v.name}</a> / {d.category}</nav>
      <div class="row">
        <span class="pill">{d.category}</span>
        {d.featured && <span class="pill warn">Featured listing (paid)</span>}
        {!d.featured && d.editorsPick && <span class="pill">Editor's pick (not paid)</span>}
      </div>
      <h1>{d.name}</h1>
      <p class="lead muted">{d.tagline}</p>
      {d.thumbnail && (
        <figure class="tool-hero-img">
          <img src={d.thumbnail} alt={`${d.name} screenshot`} width="1200" height="534" fetchpriority="high" decoding="async" />
        </figure>
      )}
      
      <p class="tool-definition"><strong>{d.name}</strong> is {/^[aeiou]/i.test(d.category) ? 'an' : 'a'} {d.category.toLowerCase()} tool for {v.name.toLowerCase()}, listed under {d.pricing.toLowerCase()} pricing and best suited to {d.bestFor.charAt(0).toLowerCase() + d.bestFor.slice(1)}.</p>
      <div class="tool-description">
        <Content />
      </div>
      {d.profileTier === 'basic' && (
        <p class="notice"><strong>Basic profile.</strong> The vendor listed the essentials only. Pros, cons, pricing details and comparison pages appear once the full profile is completed from the private link in their listing email.</p>
      )}
    </article>

    <aside class="tool-sidebar fade-in">
      <div class="action-card">
        <div class="sidebar-kpis">
          <div class="kpi">
            <span class="meta">Pricing</span>
            <strong>{d.pricing}</strong>
          </div>
          <div class="kpi">
            <span class="meta">Best for</span>
            <strong style="font-size:1.05rem">{d.bestFor}</strong>
          </div>
          {d.rating && (
            <div class="kpi">
              <span class="meta">Our rating</span>
              <div class="stars" style="font-size:1.2rem;" aria-label={`Rating: ${d.rating} out of 5`}>
                {[1,2,3,4,5].map((i) => (
                  <span class={`star ${i <= fullStars ? 'filled' : ''}`}>★</span>
                ))}
              </div>
            </div>
          )}
        </div>
        {facts.length > 0 && (
          <dl class="facts sidebar-facts">
            {facts.map(([k, val]) => <div><dt>{k}</dt><dd>{val}</dd></div>)}
          </dl>
        )}
        <a class="btn" href={d.website} rel={rel} target="_blank" style="width:100%; justify-content:center; padding:1rem; font-size:1.05rem;">Visit {d.name} →</a>
        {d.deal && (
          <div class="deal-box">
            <p class="deal-label">Deal from the vendor</p>
            <p class="deal-text">{d.deal.text}</p>
            {d.deal.code && <p class="deal-code"><span>Code</span><code>{d.deal.code}</code><button type="button" class="copy-code" data-code={d.deal.code}>Copy</button></p>}
            <p class="meta" style="margin:.35rem 0 0;">{d.deal.until ? `Ends ${fmtDate(d.deal.until)}. ` : ''}<a href={d.deal.url ?? d.website} rel={rel} target="_blank">Where it applies</a>. Offers are the vendor's; we do not earn a commission.</p>
          </div>
        )}
        <div class="row" style="justify-content:center; gap:1rem; margin-top: 1rem; font-size:.85rem;">

          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(`Listing: ${d.name}`)}`} style="color: var(--muted); text-decoration: none;">Claim or correct</a>
        </div>
      </div>
      {(d.pros.length || d.cons.length) > 0 && (
        <div class="action-card pc-card" style="margin-top:1rem;">
          {d.pros.length > 0 && <><p class="pc-head pro">Where it is strong</p><ul class="pc-list pro">{d.pros.map((x) => <li>{x}</li>)}</ul></>}
          {d.cons.length > 0 && <><p class="pc-head con">Where it falls short</p><ul class="pc-list con">{d.cons.map((x) => <li>{x}</li>)}</ul></>}
          {d.dataCheckedAt && <p class="meta" style="margin:.6rem 0 0;">Checked against the vendor's site on {fmtDate(d.dataCheckedAt)}.</p>}
        </div>
      )}
    </aside>
  </div>

  <section class="section fade-in" id="about-listing">
    <div class="card listing-proof">
      <h3 style="margin-top:0">About this listing</h3>
      <dl class="facts proof-facts">
        <div><dt>Listed</dt><dd>{fmtDate(d.addedDate)}</dd></div>
        <div><dt>Data checked</dt><dd>{d.dataCheckedAt ? fmtDate(d.dataCheckedAt) : 'Not yet verified against the vendor site'}</dd></div>
        <div><dt>Link to vendor</dt><dd>{linkType}</dd></div>
        <div><dt>Placement</dt><dd>{d.featured ? `Featured (paid) until ${d.featuredUntil ? fmtDate(d.featuredUntil) : 'renewal'}` : 'Free listing'}</dd></div>
        <div><dt>Appears on</dt><dd>{comparePages} compare page{comparePages === 1 ? '' : 's'} and {altPagesListedOn} alternatives page{altPagesListedOn === 1 ? '' : 's'}</dd></div>
        <div><dt>Rating</dt><dd>{d.rating ? `${d.rating} of 5, editorial. Never paid for.` : 'Not rated yet'}</dd></div>
      </dl>
      <p class="meta" style="margin:.75rem 0 0;">Paid placement buys position and the link type. It never changes the rating, the verdict on a compare page or the order of an alternatives list. <a href="/about/">Editorial policy</a>.</p>
    </div>
  </section>

  {similar.length > 0 && (
    <section class="section fade-in">
      <div class="related-section">
        <h3>Similar tools in {sameCategory.length > 0 ? d.category : v.name}</h3>
        <div class="grid">{similar.map((t) => <ToolCard tool={t} />)}</div>
      </div>
    </section>
  )}

  <section class="section fade-in" style="text-align:center;">
    <div class="row" style="justify-content:center;">
      <a class="btn ghost" href={`/tools/alternatives/${tool.id}/`}>Alternatives to {d.name}</a>
      {comparePeers.map((t) => <a class="btn ghost" href={pairPath(tool.id, t.id)}>{d.name} vs {t.data.name}</a>)}
    </div>
  </section>

  <section class="section fade-in">
    <Newsletter />
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach((b) => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.code || ''); const t = b.textContent; b.textContent = 'Copied'; setTimeout(() => (b.textContent = t), 1500); } catch {}
    }));
  </script>
</Base>
