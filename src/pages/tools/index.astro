---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getCollection } from 'astro:content';
import { VERTICALS } from '../../data/taxonomy';

const tools = (await getCollection('tools')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || Number(b.data.editorsPick) - Number(a.data.editorsPick) || a.data.name.localeCompare(b.data.name));

const byVertical = VERTICALS.map((v) => {
  const vt = tools.filter((t) => t.data.vertical === v.slug);
  const cats = v.categories.filter((c) => vt.some((t) => t.data.category === c));
  return { ...v, tools: vt, cats };
});
const live = byVertical.filter((v) => v.tools.length > 0);
const open = byVertical.filter((v) => v.tools.length === 0);
const catCount = (c: string) => tools.filter((t) => t.data.category === c).length;

const sortedLive = [...live].sort((a, b) => b.tools.length - a.tools.length);
const popular = sortedLive.slice(0, 5);
const more = sortedLive.slice(5);
---
<Base title="Software directory: compare business tools" description="Discover, compare, and choose the best software for your business. Browse by category, from finance and marketing to support and engineering.">
  <section class="hero">
    <h1>Software directory</h1>
    <p class="lead">Discover, compare, and choose the best software for your business.</p>

    <div class="search-bar" style="margin-top:1rem;">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="tool-search" placeholder={`Search ${tools.length} tools...`} autocomplete="off" />
    </div>

    <div class="filter-pills" id="filter-pills">
      <button class="pill active" data-filter="all">All ({tools.length})</button>
      {popular.map((v) => (
        <button class="pill" data-filter={`v:${v.slug}`}>{v.short} ({v.tools.length})</button>
      ))}
      {more.length > 0 && (
        <button class="pill" id="more-btn">+ More</button>
      )}
      {more.map((v) => (
        <button class="pill more-pill hidden" data-filter={`v:${v.slug}`}>{v.short} ({v.tools.length})</button>
      ))}
    </div>
  </section>

  {live.map((v) => (
    <section class="section tool-section fade-in" id={v.slug} data-vertical={v.slug}>
      <div class="row" style="justify-content:space-between; align-items:baseline; margin-bottom:1.5rem;">
        <h2 style="margin:0">{v.name}</h2>
      </div>
      
      <div class="grid" style="margin-bottom: 1.5rem;">
        {v.tools.map((t, i) => <ToolCard tool={t} data-overflow={i >= 4 ? 'true' : undefined} />)}
      </div>

      {v.tools.length > 4 && (
        <div style="text-align: right; border-top: 1px solid var(--border); padding-top: 1rem;">
          <a href={`/categories/${v.slug}/`} style="font-weight: 500; color: var(--accent);">
            View all {v.tools.length} &rarr;
          </a>
        </div>
      )}
    </section>
  ))}

  <style>
    [data-overflow="true"] { display: none; }
    body.is-searching [data-overflow="true"] { display: flex; /* overridden by inline style if no match */ }
  </style>



  {open.length > 0 && (
    <section class="section fade-in" id="open-categories">
      <h2 style="margin-top:0">Open categories</h2>
      <p class="muted" style="margin-bottom:1.25rem;">No listings yet in these areas. Any product can be submitted for free. The first tools in a category are reviewed within 5 business days and sit at the top of the page until others arrive.</p>
      <div class="grid">
        {open.map((v) => (
          <div class="card">
            <span class="pill">Open for listings</span>
            <h3><a href={`/categories/${v.slug}/`}>{v.name}</a></h3>
            <p class="muted" style="flex:1; font-size:.93rem;">{v.blurb}</p>
            <a href="/submit-tool/" style="font-size:.9rem; font-weight:500;">List the first tool</a>
          </div>
        ))}
      </div>
    </section>
  )}

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>('#filter-pills .pill');
    const sections = document.querySelectorAll<HTMLElement>('.tool-section');
    const cards = document.querySelectorAll<HTMLElement>('.tool-section .card');
    const search = document.getElementById('tool-search') as HTMLInputElement | null;

    const setActive = (pill: HTMLButtonElement) => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
    };

    const applyFilter = (filter: string) => {
      sections.forEach((s) => {
        const vertical = s.dataset.vertical;
        const show = filter === 'all' || (filter.startsWith('v:') && vertical === filter.slice(2));
        s.style.display = show ? '' : 'none';
      });
    };

    const moreBtn = document.getElementById('more-btn');
    const morePills = document.querySelectorAll('.more-pill');

    moreBtn?.addEventListener('click', () => {
      morePills.forEach(p => p.classList.remove('hidden'));
      moreBtn.style.display = 'none';
    });

    pills.forEach((pill) => {
      if (pill.id === 'more-btn') return;
      pill.addEventListener('click', () => {
        if (search) search.value = '';
        cards.forEach((c) => (c.style.display = ''));
        setActive(pill);
        applyFilter(pill.dataset.filter || 'all');
      });
    });

    search?.addEventListener('input', () => {
      const q = search.value.toLowerCase().trim();
      const isSearching = q.length > 0;
      
      document.body.classList.toggle('is-searching', isSearching);

      if (pills[0]) setActive(pills[0]);
      applyFilter('all');
      
      cards.forEach((c) => {
        const hay = `${c.dataset.name || ''} ${c.textContent || ''}`.toLowerCase();
        if (isSearching) {
          c.style.display = hay.includes(q) ? '' : 'none';
        } else {
          c.style.display = '';
        }
      });

      // Hide sections if all their cards are hidden by search
      sections.forEach((s) => {
        const visible = [...s.querySelectorAll<HTMLElement>('.card')].some((c) => c.style.display !== 'none');
        s.style.display = visible ? '' : 'none';
      });
    });
  </script>
</Base>
