---
import Base from '../../../layouts/Base.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const d = tool.data;

const allTools = await getCollection('tools');

const sameCategory = allTools
  .filter((t) => t.data.category === d.category && t.id !== tool.id)
  .sort((a, b) =>
    Number(b.data.featured) - Number(a.data.featured)
    || Number(b.data.editorsPick) - Number(a.data.editorsPick)
    || (b.data.rating ?? 0) - (a.data.rating ?? 0)
  );

// Prefer tools from the same vertical, then the rest of the directory
const otherCategory = allTools
  .filter((t) => t.data.category !== d.category && t.id !== tool.id)
  .sort((a, b) =>
    Number(b.data.vertical === d.vertical) - Number(a.data.vertical === d.vertical)
    || Number(b.data.featured) - Number(a.data.featured)
    || Number(b.data.editorsPick) - Number(a.data.editorsPick)
    || (b.data.rating ?? 0) - (a.data.rating ?? 0)
  )
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Alternatives to ${d.name}`,
  description: `The best alternatives to ${d.name} for ${d.category.toLowerCase()} in 2026.`,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={`Best alternatives to ${d.name} (2026)`} description={`Looking for an alternative to ${d.name}? Compare the top ${d.category.toLowerCase()} tools side by side with pricing, ratings and use cases.`} jsonLd={jsonLd}>
  <section class="hero">
    <p class="meta" style="margin:0 0 .85rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; font-size:.76rem; color:var(--accent);">{d.category}</p>
    <h1>Best alternatives to {d.name}</h1>
    <p class="lead">{d.name} is {d.pricing.toLowerCase() === 'free' ? 'free' : `a ${d.pricing.toLowerCase()} tool`} for {d.bestFor.toLowerCase()}. Here are the top alternatives if you are evaluating your options.</p>
  </section>

  <section class="section fade-in">
    <div class="alt-reference card" style="margin-bottom:2rem;">
      <div class="row" style="justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div style="flex:1; min-width:200px;">
          <span class="pill" style="margin-bottom:.35rem;">{d.category}</span>
          <h3 style="margin:.25rem 0;">{d.name}</h3>
          <p class="muted" style="margin:0; font-size:.93rem;">{d.tagline}</p>
          <p class="meta" style="margin:.5rem 0 0;">Pricing: {d.pricing}{d.rating ? ` | Rating: ${d.rating}/5` : ''} | Best for: {d.bestFor}</p>
        </div>
        <a class="btn ghost" href={`/tools/${tool.id}/`} style="font-size:.85rem; padding:.4rem .9rem; flex-shrink:0;">Read full review</a>
      </div>
    </div>
  </section>

  {sameCategory.length > 0 && (
    <section class="section fade-in">
      <h2 style="margin-top:0;">{d.category} alternatives</h2>
      <p class="muted" style="margin-bottom:1.25rem;">These tools compete directly with {d.name} in the {d.category.toLowerCase()} category.</p>
      <div class="grid">{sameCategory.map((t) => <ToolCard tool={t} />)}</div>
    </section>
  )}

  {sameCategory.length > 0 && (
    <section class="section fade-in">
      <h2 style="margin-top:0;">Quick comparison</h2>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Tool</th>
              <th>Pricing</th>
              <th>Rating</th>
              <th>Best for</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>{d.name}</strong></td>
              <td>{d.pricing}</td>
              <td>{d.rating ? `${d.rating}/5` : 'N/A'}</td>
              <td>{d.bestFor}</td>
            </tr>
            {sameCategory.map((t) => (
              <tr>
                <td><a href={`/tools/${t.id}/`}>{t.data.name}</a></td>
                <td>{t.data.pricing}</td>
                <td>{t.data.rating ? `${t.data.rating}/5` : 'N/A'}</td>
                <td>{t.data.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {sameCategory.length >= 2 && (
    <section class="section fade-in">
      <h2 style="margin-top:0;">Head to head comparisons</h2>
      <p class="muted" style="margin-bottom:1rem;">Dive deeper into how {d.name} stacks up against each alternative.</p>
      <div class="grid">
        {sameCategory.map((t) => {
          const [first, second] = [tool.id, t.id].sort();
          return (
            <a href={`/tools/compare/${first}-vs-${second}/`} class="card" style="text-decoration:none; color:var(--text);">
              <h3 style="font-size:.95rem;">{d.name} vs {t.data.name}</h3>
              <p class="muted" style="margin:0; font-size:.85rem;">Compare pricing, features and ratings side by side</p>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {otherCategory.length > 0 && (
    <section class="section fade-in">
      <div class="related-section">
        <h3>Other tools you might consider</h3>
        <div class="grid">{otherCategory.map((t) => <ToolCard tool={t} />)}</div>
      </div>
    </section>
  )}
</Base>
